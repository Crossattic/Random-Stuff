function Library.AddTab(window, tabCfg)
	assert(type(window) == "table" and window.Tabs, "AddTab: invalid window handle")
	assert(type(tabCfg) == "table", "AddTab: tabCfg must be a table")
	local windowTheme = window.Theme
	local baseTheme = tabCfg.Theme or windowTheme

	local function resolve(key, default)
		return tabCfg[key] ~= nil and tabCfg[key] or baseTheme[key] ~= nil and baseTheme[key] or default
	end

	local function resolveIconSize(key, default)
		local val = resolve(key, default)
		if type(val) == "number" then return val, val end
		if type(val) == "table" and #val >= 2 then return val[1], val[2] end
		return default[1] or 16, default[2] or 16
	end

	local bgColor      = resolve("BackgroundColor", Color3.fromRGB(30, 30, 40))
	local bgTrans      = resolve("BackgroundTransparency", 0)
	local outlineColor = resolve("OutlineColor", Color3.fromRGB(80, 80, 120))
	local outlineThick = resolve("OutlineThickness", 2)
	local outlineTrans = resolve("OutlineTransparency", 0)
	local corners      = resolve("CircularCorners", 0)
	local texture      = resolve("Texture")
	local texSize      = resolve("TextureSize", {45, 45})
	local texTrans     = resolve("TextureTransparency", 0)
	local texColor     = resolve("TextureColor", Color3.fromRGB(255,255,255))

	local buttonText    = resolve("ButtonText", "Tab")
	local textSize      = resolve("ButtonTextSize", 16)
	local textColor     = resolve("ButtonTextColor", Color3.fromRGB(240,240,240))
	local textFont      = resolve("ButtonTextFont", Enum.Font.SourceSans)
	local textTrans     = resolve("ButtonTextTransparency", 0)
	local textOutlineCol = resolve("ButtonTextOutlineColor", Color3.fromRGB(0,0,0))
	local textOutlineThk = resolve("ButtonTextOutlineThickness", 0)
	local textOutlineTrn = resolve("ButtonTextOutlineTransparency", 0)
	local textOffset    = resolve("ButtonTextOffset", {0,0})
	local textAlignment = resolve("ButtonTextAlignment", "Center")

	local iconAsset    = resolve("Icon")
	local iconW, iconH = resolveIconSize("IconSize", {16, 16})
	local iconAlign    = resolve("IconAlignment", "Left")
	local iconOffset   = resolve("IconOffset", {0,0})
	local iconCircular = resolve("IconCircular", 0)
	local iconTrans    = resolve("IconTransparency", 0)
	local iconColor    = resolve("IconColor", Color3.fromRGB(255,255,255))

	local tabBtn = Instance.new("TextButton")
	tabBtn.Name = buttonText .. "_TabBtn"
	tabBtn.AutoButtonColor = false
	tabBtn.BorderSizePixel = 0
	tabBtn.Size = UDim2.new(0, 126, 0, 35)
	tabBtn.BackgroundColor3 = bgColor
	tabBtn.BackgroundTransparency = bgTrans
	tabBtn.Text = ""
	tabBtn.ZIndex = 5
	tabBtn.Parent = window.TabScroller

	if corners > 0 then
		Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, corners)
	end
	if outlineThick > 0 then
		local stroke = Instance.new("UIStroke", tabBtn)
		stroke.Thickness = outlineThick
		stroke.Color = outlineColor
		stroke.Transparency = outlineTrans
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	end

	addTextureToFrame(tabBtn, texture, texSize, texTrans, texColor, corners)

	local hasText = (buttonText and buttonText ~= "")
	local hasIcon = (iconAsset ~= nil)
	local overlap = hasIcon and hasText and iconAlign == textAlignment

	if hasIcon then
		local img = Instance.new("ImageLabel", tabBtn)
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromOffset(iconW, iconH)
		img.Image = formatAsset(iconAsset)
		img.ImageColor3 = iconColor
		img.ImageTransparency = iconTrans
		img.ZIndex = tabBtn.ZIndex + 1
		if iconAlign == "Left" then
			img.AnchorPoint = Vector2.new(0, 0.5)
			img.Position = UDim2.new(0, iconOffset[1] or 0, 0.5, iconOffset[2] or 0)
		elseif iconAlign == "Right" then
			img.AnchorPoint = Vector2.new(1, 0.5)
			img.Position = UDim2.new(1, -(iconOffset[1] or 0), 0.5, iconOffset[2] or 0)
		else
			img.AnchorPoint = Vector2.new(0.5, 0.5)
			img.Position = UDim2.new(0.5, iconOffset[1] or 0, 0.5, iconOffset[2] or 0)
		end
		if iconCircular > 0 then
			local corner = Instance.new("UICorner", img)
			corner.CornerRadius = UDim.new(0, iconCircular)
		end
	end

	if hasText then
		local lbl = Instance.new("TextLabel", tabBtn)
		lbl.BackgroundTransparency = 1
		lbl.Text = buttonText
		lbl.Font = textFont
		lbl.TextSize = textSize
		lbl.TextColor3 = textColor
		lbl.TextTransparency = textTrans
		lbl.RichText = true
		lbl.ZIndex = tabBtn.ZIndex + 1

		local offsetX = textOffset[1] or 0
		local offsetY = textOffset[2] or 0

		if overlap then
			lbl.Size = UDim2.new(1, 0, 1, 0)
			if textAlignment == "Left" then
				lbl.AnchorPoint = Vector2.new(0, 0.5)
				lbl.Position = UDim2.new(0, offsetX, 0.5, offsetY)
			elseif textAlignment == "Right" then
				lbl.AnchorPoint = Vector2.new(1, 0.5)
				lbl.Position = UDim2.new(1, -offsetX, 0.5, offsetY)
			else
				lbl.AnchorPoint = Vector2.new(0.5, 0.5)
				lbl.Position = UDim2.new(0.5, offsetX, 0.5, offsetY)
			end
		else
			if textAlignment == "Center" then
				lbl.Size = UDim2.new(1, 0, 1, 0)
				lbl.AnchorPoint = Vector2.new(0.5, 0.5)
				lbl.Position = UDim2.new(0.5, offsetX, 0.5, offsetY)
			else
				if hasIcon then
					local iconWidthPx = iconW + 8
					lbl.Size = UDim2.new(1, -iconWidthPx, 1, 0)
					if iconAlign == "Left" then
						lbl.Position = UDim2.new(0, iconWidthPx, 0, 0)
					elseif iconAlign == "Right" then
						lbl.Position = UDim2.new(0, 0, 0, 0)
					else
						lbl.Size = UDim2.new(1, 0, 1, 0)
						lbl.Position = UDim2.new(0, 0, 0, 0)
					end
				else
					lbl.Size = UDim2.new(1, 0, 1, 0)
					lbl.Position = UDim2.new(0, 0, 0, 0)
				end
				if textOffset and #textOffset >= 2 then
					lbl.Position = lbl.Position + UDim2.fromOffset(offsetX, offsetY)
				end
			end
		end

		if type(textAlignment) == "string" then
			if textAlignment == "Left" then lbl.TextXAlignment = Enum.TextXAlignment.Left
			elseif textAlignment == "Center" then lbl.TextXAlignment = Enum.TextXAlignment.Center
			elseif textAlignment == "Right" then lbl.TextXAlignment = Enum.TextXAlignment.Right
			else lbl.TextXAlignment = Enum.TextXAlignment.Center end
		elseif typeof(textAlignment) == "EnumItem" and textAlignment.EnumType == Enum.TextXAlignment then
			lbl.TextXAlignment = textAlignment
		else
			lbl.TextXAlignment = Enum.TextXAlignment.Center
		end

		if textOutlineThk > 0 then
			local stroke = Instance.new("UIStroke", lbl)
			stroke.Thickness = textOutlineThk
			stroke.Color = textOutlineCol
			stroke.Transparency = textOutlineTrn
		end
	end

	local unifiedFx = tabCfg.ButtonFx or window.ButtonFx or baseTheme.ButtonFx or Library.DefaultButtonFx
	local selectedState = { value = false }

	Library.ApplyEffects(tabBtn, unifiedFx, unifiedFx, selectedState, unifiedFx, "Highlight")

	local pageFrame = Instance.new("ScrollingFrame")
	pageFrame.Name = buttonText .. "_Page"
	pageFrame.Size = UDim2.new(1, 0, 1, 0)
	pageFrame.BackgroundTransparency = 1
	pageFrame.BorderSizePixel = 0
	pageFrame.ZIndex = 3
	pageFrame.ScrollBarThickness = 3
	pageFrame.ScrollBarImageColor3 = textColor
	pageFrame.Visible = false
	pageFrame.Parent = window.PageContainer

	local list = Instance.new("UIListLayout", pageFrame)
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 8)
	local ep = Instance.new("UIPadding", pageFrame)
	ep.PaddingTop = UDim.new(0, 8)
	ep.PaddingBottom = UDim.new(0, 20)
	list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		pageFrame.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + ep.PaddingBottom.Offset)
	end)

	local tabHandle = { Button = tabBtn, Page = pageFrame, selectedState = selectedState, Theme = baseTheme }
	table.insert(window.Tabs, tabHandle)

	local selectionThread = nil

	local function selectThisTab()
		if tabHandle.selectedState.value then return end
		if selectionThread then
			task.cancel(selectionThread)
			selectionThread = nil
		end
		
		Library._CloseAllDropdowns()
		
		for _, t in ipairs(window.Tabs) do
			if t ~= tabHandle then
				if t._selectionThread then
					task.cancel(t._selectionThread)
					t._selectionThread = nil
				end
				t.Page.Visible = false
				t.selectedState.value = false
				local hl = HighlightRegistry[t.Button]
				if hl and hl.Stop then hl.Stop() end
			end
		end
		
		selectionThread = task.spawn(function()
			task.wait(0.05)
			if selectionThread == nil then return end
			tabHandle.Page.Visible = true
			tabHandle.selectedState.value = true
			local hl = HighlightRegistry[tabHandle.Button]
			if hl and hl.Start then hl.Start() end
			selectionThread = nil
		end)
		
		tabHandle._selectionThread = selectionThread
	end

	tabBtn.MouseButton1Click:Connect(selectThisTab)

	if #window.Tabs == 1 then
		tabHandle.Page.Visible = true
		tabHandle.selectedState.value = true
		local hl = HighlightRegistry[tabHandle.Button]
		if hl and hl.Start then hl.Start() end
	end

	return tabHandle
end

