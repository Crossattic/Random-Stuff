local function buildIconTextButton(parent, cfg, defaultTheme)
	defaultTheme = defaultTheme or {}
	local hasIcon = cfg.Icon ~= nil; local hasText = (cfg.ButtonText or cfg.Text) and (cfg.ButtonText or cfg.Text) ~= ""
	local iconSz = type(cfg.IconSize or defaultTheme.IconSize)=="number" and {cfg.IconSize or 16, cfg.IconSize or 16} or cfg.IconSize or defaultTheme.IconSize or {16,16}
	local iconW, iconH = iconSz[1] or 16, iconSz[2] or 16
	local iconAlign = cfg.IconAlignment or defaultTheme.IconAlignment or "Left"
	local iconOff = cfg.IconOffset or defaultTheme.IconOffset or {0,0}
	local iconCirc = cfg.IconCircular or defaultTheme.IconCircular or 0
	local iconCol = cfg.IconColor or defaultTheme.IconColor or defaultTheme.TextColor or Color3.fromRGB(255,255,255)
	local iconTrans = cfg.IconTransparency or defaultTheme.IconTransparency or 0
	local textOff = cfg.TextOffset or cfg.ButtonTextOffset or {0,0}
	local textSize = cfg.TextSize or cfg.ButtonTextSize or defaultTheme.TextSize
	local textAlign = cfg.TextAlignment or cfg.ButtonTextAlignment or defaultTheme.TextAlignment or "Left"
	local theme = cfg.Theme or {
		BackgroundColor = cfg.BackgroundColor or defaultTheme.BackgroundColor,
		OutlineColor = cfg.OutlineColor or defaultTheme.OutlineColor,
		OutlineThickness = cfg.OutlineThickness or defaultTheme.OutlineThickness,
		CircularCorners = cfg.CircularCorners or defaultTheme.CircularCorners,
		TextColor = cfg.TextColor or defaultTheme.TextColor,
		TextFont = cfg.TextFont or defaultTheme.TextFont,
		TextOutlineThickness = cfg.TextOutlineThickness or defaultTheme.TextOutlineThickness,
		TextOutlineColor = cfg.TextOutlineColor or defaultTheme.TextOutlineColor,
		BackgroundTransparency = cfg.BackgroundTransparency or defaultTheme.BackgroundTransparency or 0,
		BackgroundOutlineTransparency = cfg.BackgroundOutlineTransparency or defaultTheme.BackgroundOutlineTransparency or 0,
	}
	local btn = Instance.new("TextButton"); btn.AutoButtonColor = false; btn.BorderSizePixel = 0
	btn.BackgroundColor3 = theme.BackgroundColor; btn.BackgroundTransparency = theme.BackgroundTransparency or 0; btn.Text = ""; btn.ZIndex = 20; btn.Parent = parent
	if theme.CircularCorners>0 then Instance.new("UICorner", btn).CornerRadius = UDim.new(0, theme.CircularCorners) end
	if theme.OutlineThickness>0 then
		local s = Instance.new("UIStroke", btn); s.Thickness = theme.OutlineThickness; s.Color = theme.OutlineColor; s.Transparency = theme.BackgroundOutlineTransparency or 0; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	end
	addTextureToFrame(btn, cfg.Texture or theme.Texture, cfg.TextureSize or theme.TextureSize, cfg.TextureTransparency or theme.TextureTransparency, cfg.TextureColor or theme.TextureColor, theme.CircularCorners)
	local iconImg, textLbl = nil, nil
	local overlap = hasIcon and hasText and iconAlign == textAlign
	if hasIcon then
		iconImg = Instance.new("ImageLabel", btn); iconImg.BackgroundTransparency = 1; iconImg.Size = UDim2.fromOffset(iconW, iconH)
		iconImg.Image = formatAsset(cfg.Icon); iconImg.ImageColor3 = iconCol; iconImg.ImageTransparency = iconTrans; iconImg.ZIndex = btn.ZIndex+1
		if iconAlign == "Left" then iconImg.AnchorPoint = Vector2.new(0,0.5); iconImg.Position = UDim2.new(0, iconOff[1] or 0, 0.5, iconOff[2] or 0)
		elseif iconAlign == "Right" then iconImg.AnchorPoint = Vector2.new(1,0.5); iconImg.Position = UDim2.new(1, -(iconOff[1] or 0), 0.5, iconOff[2] or 0)
		else iconImg.AnchorPoint = Vector2.new(0.5,0.5); iconImg.Position = UDim2.new(0.5, iconOff[1] or 0, 0.5, iconOff[2] or 0) end
		if iconCirc>0 then Instance.new("UICorner", iconImg).CornerRadius = UDim.new(0, iconCirc) end
	end
	if hasText then
		textLbl = Instance.new("TextLabel", btn); textLbl.BackgroundTransparency = 1; textLbl.Text = cfg.ButtonText or cfg.Text; textLbl.Font = theme.TextFont
		textLbl.TextSize = textSize; textLbl.TextColor3 = theme.TextColor; textLbl.RichText = true; textLbl.ZIndex = btn.ZIndex+1
		if overlap then
			textLbl.Size = UDim2.new(1,0,1,0)
			if textAlign == "Left" then textLbl.AnchorPoint = Vector2.new(0,0.5); textLbl.Position = UDim2.new(0, textOff[1] or 0, 0.5, textOff[2] or 0)
			elseif textAlign == "Right" then textLbl.AnchorPoint = Vector2.new(1,0.5); textLbl.Position = UDim2.new(1, -(textOff[1] or 0), 0.5, textOff[2] or 0)
			else textLbl.AnchorPoint = Vector2.new(0.5,0.5); textLbl.Position = UDim2.new(0.5, textOff[1] or 0, 0.5, textOff[2] or 0) end
		else
			if hasIcon then
				local iconWpx = iconW + 8; textLbl.Size = UDim2.new(1, -iconWpx, 1, 0)
				if iconAlign == "Left" then textLbl.Position = UDim2.new(0, iconWpx, 0, 0)
				elseif iconAlign == "Right" then textLbl.Position = UDim2.new(0, 0, 0, 0)
				else textLbl.Size = UDim2.new(1,0,1,0); textLbl.Position = UDim2.new(0,0,0,0) end
			else textLbl.Size = UDim2.new(1,0,1,0); textLbl.Position = UDim2.new(0,0,0,0) end
			if textOff and #textOff>=2 then textLbl.Position = textLbl.Position + UDim2.fromOffset(textOff[1] or 0, textOff[2] or 0) end
		end
		textLbl.TextXAlignment = (type(textAlign)=="string" and ({Left=Enum.TextXAlignment.Left, Center=Enum.TextXAlignment.Center, Right=Enum.TextXAlignment.Right})[textAlign]) or (typeof(textAlign)=="EnumItem" and textAlign) or Enum.TextXAlignment.Center
		if theme.TextOutlineThickness>0 then
			local s = Instance.new("UIStroke", textLbl); s.Thickness = theme.TextOutlineThickness; s.Color = theme.TextOutlineColor; s.Transparency = theme.TextOutlineTransparency or 0
		end
	end
	return btn, iconImg, textLbl
end

-- ===================== EFFECTS APPLICATION =====================
function Library.ApplyEffects(instance, normalFx, selectedFx, selectedState, highlightFx, highlightKey)
	highlightKey = highlightKey or "Highlight"
	if not normalFx or not normalFx.EffectsData then return end
	if instance:IsA("GuiButton") then instance.AutoButtonColor = false end
	registerAbsoluteColors(instance)
	instance.AnchorPoint = Vector2.new(0.5,0.5)
	instance.Position = instance.Position + UDim2.fromOffset(instance.Size.X.Offset/2, instance.Size.Y.Offset/2)
	local scale = instance:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", instance)
	scale.Scale = 1
	local hovering, currentHoverId, highlightId = false, 0, 0
	local highlightTweens, hoverTweens = {}, {}
	local pressActive, currentPressId = false, 0
	local highlightThreads, highlightPausedByHover, highlightPausedByPress, hoverResetPending = {}, false, false, false

	local function getElementNames(elements)
		local names = {}
		if elements then for _, e in ipairs(elements) do if e.Name then names[e.Name] = true end end end
		return names
	end
	local function getEffectData(effectType)
		if selectedState and selectedState.value and selectedFx and selectedFx.EffectsData["Selected"..effectType] then return selectedFx.EffectsData["Selected"..effectType] end
		return normalFx.EffectsData[effectType]
	end
	local function getHighlightConfig()
		if highlightFx and highlightFx.EffectsData and highlightFx.EffectsData[highlightKey] then return highlightFx.EffectsData[highlightKey] end
	end
	local function hoverOverlapsHighlight(hd)
		if not hd or not hd.Elements then return false end
		local hc = getHighlightConfig(); if not hc or not hc.Elements then return false end
		local hn = getElementNames(hd.Elements); local hcn = getElementNames(hc.Elements)
		for n,_ in pairs(hn) do if hcn[n] then return true end end
		return false
	end
	local function pressOverlapsHighlight(pd)
		if not pd or not pd.Elements then return false end
		local hc = getHighlightConfig(); if not hc or not hc.Elements then return false end
		local pn = getElementNames(pd.Elements); local hcn = getElementNames(hc.Elements)
		for n,_ in pairs(pn) do if hcn[n] then return true end end
		return false
	end
	local function resetHighlightColors()
		local targets = getTargetsByElement(instance)
		for _, list in pairs(targets) do for _, t in ipairs(list) do t.Obj[t.Prop] = t.Original end end
		local knob = findKnob(instance)
		if knob then
			local cache = AbsoluteColorCache[instance]
			if cache then
				if cache.KnobCircleBg then knob.BackgroundColor3 = cache.KnobCircleBg end
				if cache.KnobCircleOl then
					local stroke = knob:FindFirstChildOfClass("UIStroke"); if stroke then stroke.Color = cache.KnobCircleOl.Original end
				end
			else
				local origCol = instance:GetAttribute("OriginalKnobColor"); if origCol then knob.BackgroundColor3 = origCol end
				local stroke = knob:FindFirstChildOfClass("UIStroke")
				if stroke then
					local origOl = instance:GetAttribute("OriginalKnobOutlineColor"); if origOl then stroke.Color = origOl end
				end
			end
		end
	end
	local function stopHighlight()
		highlightId = highlightId + 1
		for _, tw in pairs(highlightTweens) do tw:Cancel() end; highlightTweens = {}
		for _, th in pairs(highlightThreads) do if th then task.cancel(th) end end; highlightThreads = {}
		resetHighlightColors()
	end
	local function startHighlight()
		local hc = getHighlightConfig(); if not hc or not hc.Elements then return end
		local myId = highlightId + 1; highlightId = myId
		for _, tw in pairs(highlightTweens) do tw:Cancel() end; highlightTweens = {}
		for _, th in pairs(highlightThreads) do if th then task.cancel(th) end end; highlightThreads = {}
		local targets = getTargetsByElement(instance)
		local hoverData = getEffectData("Hover"); local pauseOnHover = hoverData and hoverOverlapsHighlight(hoverData)
		for _, elem in ipairs(hc.Elements) do
			local steps = normalizeSequence(elem.Darkening or elem.OutlineColorChange); if not steps or #steps==0 then continue end
			local name = elem.Name
			local map = {Background=targets.Background, BackgroundOutline=targets.BackgroundOutline, KnobBackground=targets.KnobBackground, KnobBackgroundOutline=targets.KnobBackgroundOutline, KnobTrack=targets.KnobTrack, KnobTrackOutline=targets.KnobTrackOutline, Text=targets.Text, TextOutline=targets.TextOutline, Icon=targets.Icon}
			local list = map[name]; if not list or #list==0 then continue end
			local thread = task.spawn(function()
				while selectedState.value and (not hovering or not pauseOnHover) and highlightId == myId do
					for _, step in ipairs(steps) do
						if not selectedState.value or (hovering and pauseOnHover) or highlightId ~= myId then break end
						applyHighlightStep(step, name, targets, highlightTweens)
					end
					task.wait()
				end
				if not selectedState.value then resetHighlightColors() end
			end)
			highlightThreads[name] = thread
		end
	end
	local function resetHoverVisuals()
		for _, tw in pairs(hoverTweens) do tw:Cancel() end; hoverTweens = {}
		TweenService:Create(scale, HOVER_TWEEN_SMOOTH, {Scale = 1}):Play()
		local targets = getTargetsByElement(instance)
		for _, list in pairs(targets) do for _, t in ipairs(list) do TweenService:Create(t.Obj, TweenInfo.new(0.15), {[t.Prop]=t.Original}):Play() end end
		local cache = AbsoluteColorCache[instance]
		if cache then
			if cache.Background then TweenService:Create(instance, TweenInfo.new(0.15), {BackgroundColor3 = cache.Background}):Play() end
			if cache.Strokes then for _, s in ipairs(cache.Strokes) do if s.Type=="BackgroundOutline" then TweenService:Create(s.Obj, TweenInfo.new(0.15), {Color=s.Original}):Play() end end end
		end
		local knob = findKnob(instance)
		if knob then
			local cache = AbsoluteColorCache[instance]
			if cache and cache.KnobCircleBg then TweenService:Create(knob, TweenInfo.new(0.15), {BackgroundColor3 = cache.KnobCircleBg}):Play()
			else
				local origCol = instance:GetAttribute("OriginalKnobColor"); if origCol then TweenService:Create(knob, TweenInfo.new(0.15), {BackgroundColor3=origCol}):Play() end
			end
			local stroke = knob:FindFirstChildOfClass("UIStroke")
			if stroke then
				if cache and cache.KnobCircleOl then TweenService:Create(stroke, TweenInfo.new(0.15), {Color=cache.KnobCircleOl.Original}):Play()
				else
					local origOl = instance:GetAttribute("OriginalKnobOutlineColor"); if origOl then TweenService:Create(stroke, TweenInfo.new(0.15), {Color=origOl}):Play() end
				end
			end
		end
	end
	local function applyHoverVisuals(hd, hoverId, applyColors)
		if pressActive then return end
		local info, targetScale
		if hd.HoverType==1 then info,targetScale=HOVER_TWEEN_SMOOTH, HOVER_SCALE_NORMAL
		elseif hd.HoverType==2 then info,targetScale=HOVER_TWEEN_CHOPPY, HOVER_SCALE_NORMAL
		elseif hd.HoverType==3 then info,targetScale=HOVER_TWEEN_SMOOTH, HOVER_SCALE_INVERTED
		elseif hd.HoverType==4 then info,targetScale=HOVER_TWEEN_CHOPPY, HOVER_SCALE_INVERTED end
		TweenService:Create(scale, info, {Scale=targetScale}):Play()
		if not applyColors then return end
		for _, elem in ipairs(hd.Elements or {}) do
			local steps = normalizeSequence(elem.Darkening or elem.OutlineColorChange); if not steps then steps = {} end
			local targets = getTargetsByElement(instance)
			local name = elem.Name
			local map = {Background=targets.Background, BackgroundOutline=targets.BackgroundOutline, KnobBackground=targets.KnobBackground, KnobBackgroundOutline=targets.KnobBackgroundOutline, KnobTrack=targets.KnobTrack, KnobTrackOutline=targets.KnobTrackOutline, Text=targets.Text, TextOutline=targets.TextOutline, Icon=targets.Icon}
			local list = map[name]; if not list or #list==0 then continue end
			task.spawn(function()
				local myHoverId = hoverId
				while hovering and myHoverId == currentHoverId do
					for _, step in ipairs(steps) do
						if not hovering or myHoverId ~= currentHoverId then break end
						applyHighlightStep(step, name, targets, hoverTweens)
					end
					task.wait()
				end
			end)
		end
	end
	HighlightRegistry[instance] = { Start = startHighlight, Stop = stopHighlight }

	instance.MouseEnter:Connect(function()
		hovering = true; currentHoverId = currentHoverId + 1; local myId = currentHoverId; hoverResetPending = false
		local hd = getEffectData("Hover")
		if hd then
			if hd.SoundFx then playSound(hd.SoundFx, hd.SoundFxVolume) end
			if hoverOverlapsHighlight(hd) then highlightPausedByHover = true; stopHighlight() end
		end
		if pressActive then return end
		if hd then applyHoverVisuals(hd, myId, true) end
	end)

	instance.MouseLeave:Connect(function()
		hovering = false; currentHoverId = currentHoverId + 1; hoverResetPending = false
		if pressActive then hoverResetPending = true; return end
		resetHoverVisuals()
		if highlightPausedByHover and selectedState and selectedState.value then highlightPausedByHover = false; startHighlight() end
	end)

	instance.MouseButton1Click:Connect(function()
		hovering = false; currentHoverId = currentHoverId + 1; hoverResetPending = false
		for _, tw in pairs(hoverTweens) do tw:Cancel() end; hoverTweens = {}
		local pd = getEffectData("Press")
		if pd then
			if pd.SoundFx then playSound(pd.SoundFx, pd.SoundFxVolume) end
			local info, clickScale, returnScale
			if pd.PressType==1 then info,clickScale,returnScale=CLICK_TWEEN_SMOOTH, CLICK_SCALE_NORMAL, 1
			elseif pd.PressType==2 then info,clickScale,returnScale=CLICK_TWEEN_CHOPPY, CLICK_SCALE_NORMAL, 1
			elseif pd.PressType==3 then info,clickScale,returnScale=CLICK_TWEEN_SMOOTH, CLICK_SCALE_INVERTED, 1
			elseif pd.PressType==4 then info,clickScale,returnScale=CLICK_TWEEN_CHOPPY, CLICK_SCALE_INVERTED, 1 end
			if info then scale.Scale = clickScale; TweenService:Create(scale, info, {Scale=returnScale}):Play() end
			local pressElements = pd.Elements or {}
			local overlap = pressOverlapsHighlight(pd)
			if overlap then highlightPausedByPress = true; stopHighlight() end
			pressActive = true; currentPressId = currentPressId + 1; local myPressId = currentPressId
			task.spawn(function()
				local pressDuration = 0
				for _, elem in ipairs(pressElements) do
					local steps = normalizeSequence(elem.Darkening or elem.OutlineColorChange)
					if steps and #steps>0 then
						local targets = getTargetsByElement(instance)
						applyFirstStepInstant(steps[1], elem.Name, targets)
						local totalDur = 0
						for i=2,#steps do totalDur = totalDur + (steps[i].Duration or 0.05) end
						if totalDur > pressDuration then pressDuration = totalDur end
						for i=2,#steps do task.spawn(function() applyHighlightStep(steps[i], elem.Name, targets, {}) end) end
					end
				end
				if pressDuration>0 then task.wait(pressDuration+0.05) end
				if currentPressId == myPressId then
					pressActive = false
					for _, elem in ipairs(pressElements) do
						local targets = getTargetsByElement(instance)
						local list = ({Background=targets.Background, BackgroundOutline=targets.BackgroundOutline, KnobBackground=targets.KnobBackground, KnobBackgroundOutline=targets.KnobBackgroundOutline, KnobTrack=targets.KnobTrack, KnobTrackOutline=targets.KnobTrackOutline, Text=targets.Text, TextOutline=targets.TextOutline, Icon=targets.Icon})[elem.Name]
						if list then for _, t in ipairs(list) do TweenService:Create(t.Obj, TweenInfo.new(0.15), {[t.Prop]=t.Original}):Play() end end
					end
					if overlap and selectedState and selectedState.value then highlightPausedByPress = false; startHighlight() end
					if not hovering and hoverResetPending then resetHoverVisuals(); hoverResetPending = false
					elseif hovering then
						local hd = getEffectData("Hover")
						if hd then currentHoverId = currentHoverId + 1; applyHoverVisuals(hd, currentHoverId, true) end
					end
				end
			end)
		end
	end)

	if selectedState and selectedState.value then startHighlight() end
end

