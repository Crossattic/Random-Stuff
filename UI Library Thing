-- Drive functionality --
local function getDriftLeanAngle(): number
	local currentVelocity = Drive and Drive.GetVelocity and Drive.GetVelocity() or Vector3.zero
	if currentVelocity.Magnitude <= 0.1 then
		return 0
	end
	local desired = getFlatLook()
	local crossY = currentVelocity.Unit:Cross(desired).Y
	return math.clamp(-crossY * math.rad(35), -math.rad(35), math.rad(35))
end

local function getHoverWheelCFrame(rootPart: BasePart, localOffset: CFrame, rollAngle: number, leanAngle: number?): CFrame
	local wheelReference = rootPart.CFrame * localOffset
	local wheelPosition = wheelReference.Position
	local resolvedLean = leanAngle
	if resolvedLean == nil then
		resolvedLean = getDriftLeanAngle()
	end
	local axle = rootPart.CFrame.UpVector
	local wheelUp = wheelReference.UpVector
	local tangent = wheelUp - axle * wheelUp:Dot(axle)
	if tangent.Magnitude < 0.001 then
		tangent = wheelReference.LookVector - axle * wheelReference.LookVector:Dot(axle)
	end
	if tangent.Magnitude < 0.001 then
		tangent = rootPart.CFrame.LookVector
	end
	tangent = tangent.Unit
	local back = axle:Cross(tangent).Unit
	local hoverCf = CFrame.fromMatrix(wheelPosition, axle, tangent, back)
	local speed = Drive and Drive.GetVelocity and Drive.GetVelocity().Magnitude or 0
	if speed < 0.35 then
		resolvedLean = 0
	end
	local leanWorld = CFrame.fromAxisAngle(rootPart.CFrame.LookVector, resolvedLean)
