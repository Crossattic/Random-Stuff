local function formatAsset(asset)
	if not asset then return nil end
	if asset == "AvatarIcon" then return "rbxthumb://type=AvatarHeadShot&id="..LocalPlayer.UserId.."&w=420&h=420" end
	if type(asset)=="number" then return "rbxassetid://"..asset end
	local n = tostring(asset):match("%d+"); if n then return "rbxassetid://"..n end
	local s = tostring(asset); if s:match("^rbx") or s:match("^http") then return s end
end

local function playSound(id, vol)
	id = formatAsset(id); if not id then return end
	vol = math.clamp(tonumber(vol) or 0.5, 0, 3)
	task.spawn(function()
		local s = Instance.new("Sound"); s.SoundId = id; s.Volume = vol; s.PlayOnRemove = true
		s.Parent = game:GetService("SoundService"); s:Destroy()
	end)
end

local function toColor3(v, def)
	def = def or Color3.fromRGB(255,255,255)
	if typeof(v)=="Color3" then return v end
	if type(v)=="table" then
		if v.R or v.r then return Color3.new(v.R or v.r, v.G or v.g, v.B or v.b)
		elseif #v >= 3 then return Color3.fromRGB(v[1], v[2], v[3]) end
	end
	return def
end

local function addTextureToFrame(frame, tex, texSz, texTrans, texCol, cr)
	if not tex then return end
	local t = Instance.new("ImageLabel", frame); t.Size = UDim2.new(1,0,1,0); t.BackgroundTransparency = 1
	t.Image = formatAsset(tex); t.ImageTransparency = texTrans or 0; t.ImageColor3 = texCol or Color3.fromRGB(255,255,255)
	t.ScaleType = Enum.ScaleType.Tile
	t.TileSize = (type(texSz)=="table" and UDim2.fromOffset(texSz[1] or 45, texSz[2] or 45)) or UDim2.fromOffset(45,45)
	t.ZIndex = frame.ZIndex + 1
	if cr and cr>0 then Instance.new("UICorner", t).CornerRadius = UDim.new(0,cr) end
	return t
end

local function findKnob(inst)
	for _,c in ipairs(inst:GetDescendants()) do if c.Name=="Knob" and c:IsA("Frame") then return c end end
end

local function registerAbsoluteColors(inst)
	if AbsoluteColorCache[inst] then return end
	local d = {
		Background = nil,
		Text = {}, Icon = {}, Strokes = {},
		KnobCircleBg = nil, KnobCircleOl = nil,
		KnobTrackBg = nil, KnobTrackOl = nil
	}
	if inst:IsA("GuiObject") then d.Background = inst.BackgroundColor3 end
	local ms = inst:FindFirstChildOfClass("UIStroke")
	if ms then table.insert(d.Strokes, {Obj=ms, Prop="Color", Original=ms.Color, Type="BackgroundOutline"}) end
	for _,c in ipairs(inst:GetDescendants()) do
		if c:IsA("TextLabel") or c:IsA("TextBox") or c:IsA("TextButton") then
			table.insert(d.Text, {Obj=c, Prop="TextColor3", Original=c.TextColor3})
			local ts = c:FindFirstChildOfClass("UIStroke")
			if ts then table.insert(d.Strokes, {Obj=ts, Prop="Color", Original=ts.Color, Type="TextOutline"}) end
		elseif c:IsA("ImageLabel") or c:IsA("ImageButton") then
			table.insert(d.Icon, {Obj=c, Prop="ImageColor3", Original=c.ImageColor3})
		end
		if c.Name=="Knob" and c:IsA("Frame") then
			d.KnobCircleBg = c.BackgroundColor3
			local ks = c:FindFirstChildOfClass("UIStroke")
			if ks then d.KnobCircleOl = {Obj=ks, Prop="Color", Original=ks.Color} end
			local track = c.Parent
			if track and track:IsA("Frame") and track.Name=="KnobTrack" then
				d.KnobTrackBg = track.BackgroundColor3
				local ts = track:FindFirstChildOfClass("UIStroke")
				if ts then d.KnobTrackOl = {Obj=ts, Prop="Color", Original=ts.Color} end
			end
		end
	end
	AbsoluteColorCache[inst] = d
end

local function getTargetsByElement(inst)
	local cache = AbsoluteColorCache[inst]
	local t = {
		Background = {}, BackgroundOutline = {}, Text = {}, TextOutline = {}, Icon = {},
		KnobBackground = {}, KnobBackgroundOutline = {}, KnobTrack = {}, KnobTrackOutline = {},
	}
	if inst:IsA("GuiObject") then
		table.insert(t.Background, {Obj=inst, Prop="BackgroundColor3", Original=cache and cache.Background or inst.BackgroundColor3})
	end
	if cache and cache.Strokes then
		for _,s in ipairs(cache.Strokes) do
			if s.Type=="BackgroundOutline" then table.insert(t.BackgroundOutline, s)
			elseif s.Type=="TextOutline" then table.insert(t.TextOutline, s) end
		end
	end
	if cache then
		for _,x in ipairs(cache.Text) do table.insert(t.Text, x) end
		for _,x in ipairs(cache.Icon) do table.insert(t.Icon, x) end
	end
	local knob = findKnob(inst)
	if knob then
		table.insert(t.KnobBackground, {Obj=knob, Prop="BackgroundColor3", Original=cache and cache.KnobCircleBg or knob.BackgroundColor3})
		local ks = knob:FindFirstChildOfClass("UIStroke")
		if ks then
			table.insert(t.KnobBackgroundOutline, {Obj=ks, Prop="Color", Original=cache and cache.KnobCircleOl and cache.KnobCircleOl.Original or ks.Color})
		end
		local track = knob.Parent
		if track and track:IsA("Frame") and track.Name=="KnobTrack" then
			table.insert(t.KnobTrack, {Obj=track, Prop="BackgroundColor3", Original=cache and cache.KnobTrackBg or track.BackgroundColor3})
			local ts = track:FindFirstChildOfClass("UIStroke")
			if ts then
				table.insert(t.KnobTrackOutline, {Obj=ts, Prop="Color", Original=cache and cache.KnobTrackOl and cache.KnobTrackOl.Original or ts.Color})
			end
		end
	end
	return t
end

local function normalizeSequence(data)
	if not data then return nil end
	if data.Sequence then return data.Sequence end
	if data.Color ~= nil then return {data} end
	return data
end

local function applyHighlightStep(step, elemName, targets, tweenStore)
	local dur = step.Duration or 0.05
	if step.Color == nil then return end
	local function playTween(obj, prop, col)
		if tweenStore[elemName] then tweenStore[elemName]:Cancel() end
		local tw = TweenService:Create(obj, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {[prop] = col})
		tweenStore[elemName] = tw; tw:Play(); tw.Completed:Wait(); tweenStore[elemName] = nil
	end
	local function getCol(original, stepCol)
		if stepCol=="Original" then return original
		elseif typeof(stepCol)=="Color3" then return stepCol
		elseif type(stepCol)=="table" and #stepCol>=3 then
			return Color3.new(math.clamp(original.R+stepCol[1]/255,0,1), math.clamp(original.G+stepCol[2]/255,0,1), math.clamp(original.B+stepCol[3]/255,0,1))
		else return original end
	end
	local map = {
		Background = targets.Background,
		BackgroundOutline = targets.BackgroundOutline,
		KnobBackground = targets.KnobBackground,
		KnobBackgroundOutline = targets.KnobBackgroundOutline,
		KnobTrack = targets.KnobTrack,
		KnobTrackOutline = targets.KnobTrackOutline,
		Text = targets.Text,
		TextOutline = targets.TextOutline,
		Icon = targets.Icon,
	}
	local list = map[elemName]
	if not list then return end
	for _, t in ipairs(list) do
		local targetCol
		if elemName:find("Outline") or elemName:find("TrackOutline") then
			if step.Color == "Original" then targetCol = t.Original
			elseif typeof(step.Color) == "Color3" then targetCol = step.Color
			elseif type(step.Color) == "table" and #step.Color >= 3 then
				targetCol = Color3.new(math.clamp(t.Original.R + step.Color[1]/255,0,1), math.clamp(t.Original.G + step.Color[2]/255,0,1), math.clamp(t.Original.B + step.Color[3]/255,0,1))
			else targetCol = t.Original end
		else
			targetCol = getCol(t.Original, step.Color)
		end
		playTween(t.Obj, t.Prop, targetCol)
	end
end

local function applyFirstStepInstant(step, elemName, targets)
	if step.Color == nil then return end
	local function setCol(t, col) t.Obj[t.Prop] = col end
	local map = {
		Background = targets.Background,
		BackgroundOutline = targets.BackgroundOutline,
		KnobBackground = targets.KnobBackground,
		KnobBackgroundOutline = targets.KnobBackgroundOutline,
		KnobTrack = targets.KnobTrack,
		KnobTrackOutline = targets.KnobTrackOutline,
		Text = targets.Text,
		TextOutline = targets.TextOutline,
		Icon = targets.Icon,
	}
	local list = map[elemName]; if not list then return end
	for _, t in ipairs(list) do
		local col
		if elemName:find("Outline") or elemName:find("TrackOutline") then
			if step.Color == "Original" then col = t.Original
			elseif typeof(step.Color) == "Color3" then col = step.Color
			elseif type(step.Color) == "table" and #step.Color >= 3 then
				col = Color3.new(math.clamp(t.Original.R + step.Color[1]/255,0,1), math.clamp(t.Original.G + step.Color[2]/255,0,1), math.clamp(t.Original.B + step.Color[3]/255,0,1))
			else col = t.Original end
		else
			if step.Color=="Original" then col = t.Original
			elseif typeof(step.Color)=="Color3" then col = step.Color
			elseif type(step.Color)=="table" and #step.Color>=3 then
				col = Color3.new(math.clamp(t.Original.R+step.Color[1]/255,0,1), math.clamp(t.Original.G+step.Color[2]/255,0,1), math.clamp(t.Original.B+step.Color[3]/255,0,1))
			else col = t.Original end
		end
		setCol(t, col)
	end
end

local function makeDraggable(frame)
	local dragging, dragInput, dragStart, startPos
	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true; dragStart = input.Position; startPos = frame.Position
			input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
		end
	end)
	frame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
end

