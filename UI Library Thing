		labelObj.Size = UDim2.new(1,0,0,labelHeight)
		labelObj.Position = UDim2.new(0, labelOff[1] or 0, 0, labelOff[2] or 0)
		if labelOlThick>0 then
			local s = Instance.new("UIStroke", labelObj)
			s.Thickness = labelOlThick
			s.Color = labelOlCol
			s.Transparency = labelOlTrans
		end
		btn, textLabel = buildDropdown(container, labelHeight+textGap)
	elseif textSide=="Down" then
		labelObj = Instance.new("TextLabel", container)
		labelObj.BackgroundTransparency = 1
		labelObj.Text = labelText
		labelObj.Font = labelFont
		labelObj.TextSize = labelSz
		labelObj.TextColor3 = labelCol
		labelObj.TextTransparency = labelTrans
		labelObj.RichText = true
		labelObj.ZIndex = 6
		labelObj.TextXAlignment = Enum.TextXAlignment.Center
		labelObj.Size = UDim2.new(1,0,0,labelHeight)
		labelObj.Position = UDim2.new(0, labelOff[1] or 0, 0, buttonH+textGap+(labelOff[2] or 0))
		if labelOlThick>0 then
			local s = Instance.new("UIStroke", labelObj)
			s.Thickness = labelOlThick
			s.Color = labelOlCol
			s.Transparency = labelOlTrans
		end
		btn, textLabel = buildDropdown(container, 0)
	end

	local function clearOptionHighlights()
		for _, optBtn in ipairs(optionButtons) do
			local hl = HighlightRegistry[optBtn]
			if hl and hl.Stop then hl.Stop() end
		end
		selectedOptionButton = nil
	end
	
	local function rotateArrow(targetRotation, duration)
		if arrowImg then
			local info = TweenInfo.new(duration or 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			local tween = TweenService:Create(arrowImg, info, {Rotation = targetRotation})
			tween:Play()
			arrowRotation = targetRotation
		end
	end

	local function getScreenGui()
		if not btn then return PlayerGui end
		return btn:FindFirstAncestorOfClass("ScreenGui") or PlayerGui
	end
	
	local function positionPopup()
		if not popupData.Frame or not btn or not btn.Parent then return end
		local btnAbsPos, btnAbsSize
		local ok, err = pcall(function()
			btnAbsPos = btn.AbsolutePosition
			btnAbsSize = btn.AbsoluteSize
		end)
		if not ok then return end
		local popupW = popupData.Width or 120
		local popupH = popupData.Height or 60
		local screenGui = getScreenGui()
		if not screenGui then return end
		local screenSize = screenGui.AbsoluteSize
		if screenSize.X==0 or screenSize.Y==0 then return end
		local x, y
		if boardSide=="Left" then
			x = btnAbsPos.X - popupW - 6
			x = math.max(0, math.min(x, screenSize.X - popupW))
		else
			x = btnAbsPos.X + btnAbsSize.X + 6
			x = math.max(0, math.min(x, screenSize.X - popupW))
		end
		y = btnAbsPos.Y
		y = math.max(0, math.min(y, screenSize.Y - popupH))
		popupData.Frame.Position = UDim2.new(0,x,0,y)
	end
	
	local function closePopup()
		if not popupData.Open then return end
		popupData.Open = false
		
		selectedState.value = false
		local hl = HighlightRegistry[btn]
		if hl and hl.Stop then hl.Stop() end
		
		local targetRotation = arrowRotation + 180
		rotateArrow(targetRotation, 0.25)
		
		if popupData.Frame then
			popupData.Frame:Destroy()
			popupData.Frame = nil
		end
		if popupData.UserInputConnection then
			popupData.UserInputConnection:Disconnect()
			popupData.UserInputConnection = nil
		end
		if popupData.RenderConnection then
			popupData.RenderConnection:Disconnect()
			popupData.RenderConnection = nil
		end
		for i=#openDropdownClosers,1,-1 do
			if openDropdownClosers[i]==closePopup then
				table.remove(openDropdownClosers,i)
			end
		end
		
		clearOptionHighlights()
	end
	
	local function createPopup()
		if popupData.Frame then return end
		local screenGui = getScreenGui()
		local popupFrame = Instance.new("Frame")
		popupFrame.Name = "DropdownPopup"
		popupFrame.BackgroundColor3 = boardBgCol
		popupFrame.BackgroundTransparency = boardBgTrans
		popupFrame.BorderSizePixel = 0
		popupFrame.ZIndex = 100
		popupFrame.Active = false
		popupFrame.Draggable = false
		popupFrame.Parent = screenGui
		if boardCorners>0 then
			Instance.new("UICorner", popupFrame).CornerRadius = UDim.new(0,boardCorners)
		end
		if boardOlThick>0 then
			local s = Instance.new("UIStroke", popupFrame)
			s.Thickness = boardOlThick
			s.Color = boardOlCol
			s.Transparency = boardOlTrans
			s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		end
		addTextureToFrame(popupFrame, boardTex, boardTexSz, boardTexTrans, boardTexCol, boardCorners)
		
		local headerHeight = 30
		local headerFrame = Instance.new("Frame", popupFrame)
		headerFrame.Size = UDim2.new(1,-16,0,headerHeight)
		headerFrame.Position = UDim2.new(0,8,0,4)
		headerFrame.BackgroundTransparency = 1
		headerFrame.ZIndex = 101
		
		local boardIconImg = nil
		local hasIcon = boardIconAsset and true or false
		if hasIcon then
			boardIconImg = Instance.new("ImageLabel", headerFrame)
			boardIconImg.BackgroundTransparency = 1
			boardIconImg.Size = UDim2.fromOffset(boardIconW, boardIconH)
			boardIconImg.Image = formatAsset(boardIconAsset)
			boardIconImg.ImageColor3 = boardIconCol
			boardIconImg.ImageTransparency = boardIconTrans
			boardIconImg.ZIndex = 102
			local align = boardIconAlign
			local offX = boardIconOff[1] or 0
			local offY = boardIconOff[2] or 0
			if align=="Left" then
				boardIconImg.AnchorPoint=Vector2.new(0,0.5)
				boardIconImg.Position=UDim2.new(0,offX,0.5,offY)
			elseif align=="Right" then
				boardIconImg.AnchorPoint=Vector2.new(1,0.5)
				boardIconImg.Position=UDim2.new(1,-offX,0.5,offY)
			else
				boardIconImg.AnchorPoint=Vector2.new(0.5,0.5)
				boardIconImg.Position=UDim2.new(0.5,offX,0.5,offY)
			end
			if boardIconCirc>0 then
				Instance.new("UICorner", boardIconImg).CornerRadius = UDim.new(0,boardIconCirc)
			end
		end
		
		local titleLabel = Instance.new("TextLabel", headerFrame)
		titleLabel.BackgroundTransparency = 1
		titleLabel.Text = popupTitle
		titleLabel.Font = boardTitleFont
		titleLabel.TextSize = boardTitleSz
		titleLabel.TextColor3 = boardTitleCol
		titleLabel.TextTransparency = boardTitleTrans
		titleLabel.RichText = true
		titleLabel.ZIndex = 103
		local textAlign = boardTitleAlign
		local textAlignEnum = (textAlign=="Left" and Enum.TextXAlignment.Left) or (textAlign=="Right" and Enum.TextXAlignment.Right) or Enum.TextXAlignment.Center
		titleLabel.TextXAlignment = textAlignEnum
		titleLabel.TextYAlignment = Enum.TextYAlignment.Center
		local overlap = hasIcon and boardIconAlign==textAlign
		local offX = boardTitleOff[1] or 0
		local offY = boardTitleOff[2] or 0
		if overlap then
			titleLabel.Size = UDim2.new(1,0,1,0)
			if textAlign=="Left" then
				titleLabel.AnchorPoint=Vector2.new(0,0.5)
				titleLabel.Position=UDim2.new(0,offX,0.5,offY)
			elseif textAlign=="Right" then
				titleLabel.AnchorPoint=Vector2.new(1,0.5)
				titleLabel.Position=UDim2.new(1,-offX,0.5,offY)
			else
				titleLabel.AnchorPoint=Vector2.new(0.5,0.5)
				titleLabel.Position=UDim2.new(0.5,offX,0.5,offY)
			end
		else
			titleLabel.Size = UDim2.new(1,0,1,0)
			if textAlign=="Left" then
				titleLabel.AnchorPoint=Vector2.new(0,0.5)
				titleLabel.Position=UDim2.new(0,offX,0.5,offY)
			elseif textAlign=="Right" then
				titleLabel.AnchorPoint=Vector2.new(1,0.5)
				titleLabel.Position=UDim2.new(1,-offX,0.5,offY)
			else
				titleLabel.AnchorPoint=Vector2.new(0.5,0.5)
				titleLabel.Position=UDim2.new(0.5,offX,0.5,offY)
			end
		end
		if boardTitleOlThick>0 then
			local s = Instance.new("UIStroke", titleLabel)
			s.Thickness = boardTitleOlThick
			s.Color = boardTitleOlCol
			s.Transparency = boardTitleOlTrans
		end
		
		local maxPerColumn = 5
		local cellW = 54
		local cellH = 22
		local cellPadding = 4
		local gridPadding = 5
		local columns = math.ceil(#options / maxPerColumn)
		local rows = math.min(#options, maxPerColumn)
		local contentW = columns*(cellW+cellPadding)-cellPadding + gridPadding*2
		local contentH = rows*(cellH+cellPadding)-cellPadding + gridPadding*2
		
		local optionsScroll = Instance.new("ScrollingFrame", popupFrame)
		optionsScroll.Size = UDim2.new(0,contentW,0,contentH)
		optionsScroll.Position = UDim2.new(0,8,0,headerHeight+8)
		optionsScroll.BackgroundTransparency = 1
		optionsScroll.BorderSizePixel = 0
		optionsScroll.ZIndex = 104
		optionsScroll.ScrollBarThickness = 3
		optionsScroll.ScrollBarImageColor3 = boardTitleCol or Color3.fromRGB(255,255,255)
		optionsScroll.CanvasSize = UDim2.new(0,contentW,0,contentH)
		optionsScroll.ClipsDescendants = true
		
		local gridLayout = Instance.new("UIGridLayout", optionsScroll)
		gridLayout.FillDirection = Enum.FillDirection.Vertical
		gridLayout.FillDirectionMaxCells = maxPerColumn
		gridLayout.CellSize = UDim2.new(0,cellW,0,cellH)
		gridLayout.CellPadding = UDim2.new(0,cellPadding,0,cellPadding)
		gridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		gridLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
		
		local gridPad = Instance.new("UIPadding", optionsScroll)
		gridPad.PaddingTop = UDim.new(0,gridPadding)
		gridPad.PaddingBottom = UDim.new(0,gridPadding)
		gridPad.PaddingLeft = UDim.new(0,gridPadding)
		gridPad.PaddingRight = UDim.new(0,gridPadding)
		
		optionButtons = {}
		
		for i, opt in ipairs(options) do
			local optBtn = Instance.new("TextButton", optionsScroll)
			optBtn.Size = UDim2.new(1,0,1,0)
			optBtn.BackgroundColor3 = btnBgCol
			optBtn.BackgroundTransparency = btnBgTrans
			optBtn.Text = opt
			optBtn.TextColor3 = btnTextCol
			optBtn.TextTransparency = btnTextTrans
			optBtn.Font = btnTextFont
			optBtn.TextSize = btnTextSz
			optBtn.AutoButtonColor = false
			optBtn.BorderSizePixel = 0
			optBtn.ZIndex = 105
			
			optBtn.TextXAlignment = parseAlignment(btnTextAlignment)
			optBtn.TextYAlignment = Enum.TextYAlignment.Center
			
			if btnTextOffset and #btnTextOffset >= 2 then
				local offX = btnTextOffset[1] or 0
				local offY = btnTextOffset[2] or 0
				if offX ~= 0 or offY ~= 0 then
					local pad = Instance.new("UIPadding", optBtn)
					if offX ~= 0 then
						pad.PaddingLeft = UDim.new(0, offX)
						pad.PaddingRight = UDim.new(0, -offX)
					end
					if offY ~= 0 then
						pad.PaddingTop = UDim.new(0, offY)
						pad.PaddingBottom = UDim.new(0, -offY)
					end
				end
			end
			
			if btnCorners>0 then
				Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0,math.min(4,btnCorners))
			end
			if btnOlThick>0 then
				local s = Instance.new("UIStroke", optBtn)
				s.Thickness = btnOlThick
				s.Color = btnOlCol
				s.Transparency = btnOlTrans
				s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			end
			if btnTex then
				addTextureToFrame(optBtn, btnTex, btnTexSz, btnTexTrans, btnTexCol, btnCorners)
			end
			
			local isSelected = (opt == selectedValue)
			local optionSelectedState = { value = isSelected }
			
			if fx then
				Library.ApplyEffects(optBtn, fx, fx, optionSelectedState, fx, "OptionHighlight", "SelectedOption")
			end
			
			table.insert(optionButtons, optBtn)
			
			if isSelected then
				local hl = HighlightRegistry[optBtn]
				if hl and hl.Start then hl.Start() end
				selectedOptionButton = optBtn
			end
			
			optBtn.MouseButton1Click:Connect(function()
				if selectedOptionButton then
					local prevHl = HighlightRegistry[selectedOptionButton]
					if prevHl and prevHl.Stop then prevHl.Stop() end
				end
				
				selectedValue = opt
				if textLabel then
					textLabel.Text = opt
				end
				
				optionSelectedState.value = true
				local hl = HighlightRegistry[optBtn]
				if hl and hl.Start then hl.Start() end
				selectedOptionButton = optBtn
				
				if callback then callback(opt) end
				closePopup()
			end)
		end
		
		local popupW = contentW + 16
		local popupH = headerHeight + 8 + contentH + 8
		popupFrame.Size = UDim2.new(0,popupW,0,popupH)
		popupData.Frame = popupFrame
		popupData.Width = popupW
		popupData.Height = popupH
		
		local function onInputBegan(input, gameProcessed)
			if gameProcessed then return end
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				local pos = input.Position
				if not popupData.Frame or not popupData.Frame.Parent then return end
				local absPos = popupData.Frame.AbsolutePosition
				local absSize = popupData.Frame.AbsoluteSize
				local inside = pos.X>=absPos.X and pos.X<=absPos.X+absSize.X and pos.Y>=absPos.Y and pos.Y<=absPos.Y+absSize.Y
				local onButton = false
				if btn and btn.Parent then
					local btnAbsPos = btn.AbsolutePosition
					local btnAbsSize = btn.AbsoluteSize
					onButton = pos.X>=btnAbsPos.X and pos.X<=btnAbsPos.X+btnAbsSize.X and pos.Y>=btnAbsPos.Y and pos.Y<=btnAbsPos.Y+btnAbsSize.Y
				end
				if not inside and not onButton then closePopup() end
			end
		end
		
		popupData.UserInputConnection = UserInputService.InputBegan:Connect(onInputBegan)
		local renderConn = RunService.RenderStepped:Connect(function()
			if popupData.Open and popupData.Frame then positionPopup() end
		end)
		popupData.RenderConnection = renderConn
		table.insert(openDropdownClosers, closePopup)
	end
	
	local function openPopup()
		if popupData.Open then return end
		
		selectedState.value = true
		local hl = HighlightRegistry[btn]
		if hl and hl.Start then hl.Start() end
		
		local targetRotation = arrowRotation + 180
		rotateArrow(targetRotation, 0.25)
		
		if not popupData.Frame then createPopup() end
		popupData.Open = true
		if popupData.Frame then
			popupData.Frame.Visible = true
			positionPopup()
		end
	end
	
	local function togglePopup()
		if popupData.Open then
			closePopup()
		else
			Library._CloseAllDropdowns()
			openPopup()
		end
	end
	
	if btn then
		btn.MouseButton1Click:Connect(togglePopup)
	end
	
	updateOffset(scrollFrame, buttonW)
	if parent.RefreshHeight then parent.RefreshHeight() end
	return btn
end

-- ===================== MULTI-DROPDOWN =====================
function Library.AddMultiDropdown(parent, cfg)
	local scrollFrame = parent.ScrollFrame or parent
	assert(scrollFrame:IsA("ScrollingFrame"))
	local function getNextOffset(p) return p:GetAttribute("NextOffset") or -10 end
	local function updateOffset(p, w) local cur = p:GetAttribute("NextOffset") or -10; p:SetAttribute("NextOffset", cur - (w+10)) end
	local baseTheme = cfg.Theme or parent.Theme or {}
	local boardCfg = cfg.PopupBoard or {}; local boardTheme = boardCfg.Theme or baseTheme
	local buttonsCfg = cfg.PopupBoardButtons or {}; local buttonsTheme = buttonsCfg.Theme or boardTheme

	local function resolve(k,d) 
		return cfg[k]~=nil and cfg[k] or baseTheme[k]~=nil and baseTheme[k] or d 
	end
	local function resolveBoard(k,d) 
		return boardCfg[k]~=nil and boardCfg[k] or boardTheme[k]~=nil and boardTheme[k] or d 
	end
	local function resolveButtons(k,d) 
		return buttonsCfg[k]~=nil and buttonsCfg[k] or buttonsTheme[k]~=nil and buttonsTheme[k] or d 
	end

	local function resolveIconSize(k,d)
		local v = resolve(k,d); if type(v)=="number" then return v,v end; if type(v)=="table" and #v>=2 then return v[1],v[2] end; return d[1] or 16, d[2] or 16
	end
	local function resolveBoardIconSize(k,d)
		local v = resolveBoard(k,d); if type(v)=="number" then return v,v end; if type(v)=="table" and #v>=2 then return v[1],v[2] end; return d[1] or 16, d[2] or 16
	end

	-- Main button theme
	local buttonW = cfg.Width or 60; local buttonH = cfg.Height or 25
	local bgCol = resolve("BackgroundColor", Color3.fromRGB(30,30,40))
	local bgTrans = resolve("BackgroundTransparency",0)
	local olCol = resolve("OutlineColor", Color3.fromRGB(80,80,120))
	local olThick = resolve("OutlineThickness",2)
	local olTrans = resolve("OutlineTransparency",0)
	local tex = resolve("Texture")
	local texSz = resolve("TextureSize",{45,45})
	local texTrans = resolve("TextureTransparency",0)
	local texCol = resolve("TextureColor",Color3.fromRGB(255,255,255))
	local corners = resolve("CircularCorners",0)

	-- Label (outside)
	local labelText = resolve("Text","")
	local labelCol = resolve("TextColor",Color3.fromRGB(240,240,240))
	local labelFont = resolve("TextFont",Enum.Font.SourceSans)
	local labelSz = resolve("TextSize",12)
	local labelTrans = resolve("TextTransparency",0)
	local labelOlCol = resolve("TextOutlineColor",Color3.fromRGB(0,0,0))
	local labelOlThick = resolve("TextOutlineThickness",0)
	local labelOlTrans = resolve("TextOutlineTransparency",0)
	local labelOff = resolve("TextOffset",{0,0})
	local textSide = resolve("TextSide")
	local textGap = resolve("TextGap",2)

	-- Inside text (ButtonText)
	local buttonTextCol = resolve("ButtonTextColor", labelCol)
	local buttonFont = resolve("ButtonTextFont", labelFont)
	local buttonTextSz = resolve("ButtonTextSize", labelSz)
	local buttonTextTrans = resolve("ButtonTextTransparency", labelTrans)
	local buttonOlCol = resolve("ButtonTextOutlineColor", labelOlCol)
	local buttonOlThick = resolve("ButtonTextOutlineThickness", labelOlThick)
	local buttonOlTrans = resolve("ButtonTextOutlineTransparency", labelOlTrans)
	local buttonTextAlignment = resolve("ButtonTextAlignment", "Center")
	local buttonTextOffset = resolve("ButtonTextOffset", {0, 0})

	-- Icons
	local iconAsset = resolve("Icon")
	local iconW, iconH = resolveIconSize("IconSize",{16,16})
	local iconAlign = resolve("IconAlignment","Left")
	local iconOff = resolve("IconOffset",{0,0})
	local iconCirc = resolve("IconCircular",0)
	local iconTrans = resolve("IconTransparency",0)
	local iconCol = resolve("IconColor",Color3.fromRGB(255,255,255))
	local icon2Asset = resolve("Icon2")
	local icon2W, icon2H = resolveIconSize("IconSize2",{12,12})
	local icon2Align = resolve("IconAlignment2","Right")
	local icon2Off = resolve("IconOffset2",{0,0})
	local icon2Circ = resolve("IconCircular2",0)
	local icon2Trans = resolve("IconTransparency2",0)
	local icon2Col = resolve("IconColor2",Color3.fromRGB(255,255,255))

	-- Popup board theme
	local boardBgCol = resolveBoard("BackgroundColor",Color3.fromRGB(30,30,40))
	local boardBgTrans = resolveBoard("BackgroundTransparency",0)
	local boardOlCol = resolveBoard("OutlineColor",Color3.fromRGB(80,80,120))
	local boardOlThick = resolveBoard("OutlineThickness",2)
	local boardOlTrans = resolveBoard("OutlineTransparency",0)
	local boardTex = resolveBoard("Texture")
	local boardTexSz = resolveBoard("TextureSize",{45,45})
	local boardTexTrans = resolveBoard("TextureTransparency",0)
	local boardTexCol = resolveBoard("TextureColor",Color3.fromRGB(255,255,255))
	local boardCorners = resolveBoard("CircularCorners",0)
	local boardSide = resolveBoard("BoardSide", "Left")
	local boardTitleText = resolveBoard("Text","Select Option")
	local boardTitleCol = resolveBoard("TextColor",Color3.fromRGB(240,240,240))
	local boardTitleFont = resolveBoard("TextFont",Enum.Font.SourceSans)
	local boardTitleSz = resolveBoard("TextSize",14)
	local boardTitleTrans = resolveBoard("TextTransparency",0)
	local boardTitleOlCol = resolveBoard("TextOutlineColor",Color3.fromRGB(0,0,0))
	local boardTitleOlThick = resolveBoard("TextOutlineThickness",0)
	local boardTitleOlTrans = resolveBoard("TextOutlineTransparency",0)
	local boardTitleOff = resolveBoard("TextOffset",{0,0})
	local boardTitleAlign = resolveBoard("TextAlignment","Center")
	local boardIconAsset = resolveBoard("Icon")
	local boardIconW, boardIconH = resolveBoardIconSize("IconSize",{16,16})
	local boardIconAlign = resolveBoard("IconAlignment","Left")
	local boardIconOff = resolveBoard("IconOffset",{0,0})
	local boardIconCirc = resolveBoard("IconCircular",0)
	local boardIconTrans = resolveBoard("IconTransparency",0)
	local boardIconCol = resolveBoard("IconColor",Color3.fromRGB(255,255,255))

	-- Option buttons theme
	local btnBgCol = resolveButtons("BackgroundColor", Color3.fromRGB(40,40,50))
	local btnBgTrans = resolveButtons("BackgroundTransparency", 0)
	local btnOlCol = resolveButtons("OutlineColor", Color3.fromRGB(100,100,150))
	local btnOlThick = resolveButtons("OutlineThickness", 1)
	local btnOlTrans = resolveButtons("OutlineTransparency", 0)
	local btnTex = resolveButtons("Texture")
	local btnTexSz = resolveButtons("TextureSize",{45,45})
	local btnTexTrans = resolveButtons("TextureTransparency",0)
	local btnTexCol = resolveButtons("TextureColor",Color3.fromRGB(255,255,255))
	local btnCorners = resolveButtons("CircularCorners", 4)
	local btnTextCol = resolveButtons("TextColor", Color3.fromRGB(255,255,255))
	local btnTextFont = resolveButtons("TextFont", Enum.Font.SourceSans)
	local btnTextSz = resolveButtons("TextSize", 12)
	local btnTextTrans = resolveButtons("TextTransparency", 0)
	local btnTextOlCol = resolveButtons("TextOutlineColor", Color3.fromRGB(0,0,0))
	local btnTextOlThick = resolveButtons("TextOutlineThickness", 0)
	local btnTextOlTrans = resolveButtons("TextOutlineTransparency", 0)
	local btnTextAlignment = resolveButtons("ButtonTextAlignment") or "Center"
	local btnTextOffset = resolveButtons("ButtonTextOffset") or {0, 0}

	local fx = cfg.ButtonFx or baseTheme.ButtonFx or Library.DefaultButtonFx

	local options = cfg.Options or {"Option 1","Option 2","Option 3"}
	assert(#options>0)

	local defaultSelected = cfg.Default or {}
	if type(defaultSelected) ~= "table" then defaultSelected = {defaultSelected} end
	local selectedMap = {}
	for _, opt in ipairs(options) do
		selectedMap[opt] = false
	end
	for _, opt in ipairs(defaultSelected) do
		if selectedMap[opt] ~= nil then selectedMap[opt] = true end
	end

	local callback = cfg.Callback or function() end
	local popupTitle = cfg.PopupTitle or boardTitleText or "Select Options"

	local showLabel = labelText~="" and textSide~=nil
	local labelHeight = showLabel and (labelSz+4) or 0
	local xOffset = getNextOffset(scrollFrame)
	local posY = 0; local totalHeight = 0
	if not showLabel then totalHeight = buttonH; posY = 0
	elseif textSide=="Up" then totalHeight = labelHeight + textGap + buttonH; posY = labelHeight + textGap
	elseif textSide=="Down" then totalHeight = buttonH + textGap + labelHeight; posY = 0 end
	local buttonCenterOffset = posY + buttonH/2
	local container = Instance.new("Frame")
	container.BackgroundTransparency = 1
	container.Size = UDim2.new(0,buttonW,0,totalHeight)
	container.Position = UDim2.new(1, xOffset-buttonW, 0.5, -buttonCenterOffset)
	container.ZIndex = 5
	container.Parent = scrollFrame
	local btn, labelObj, iconImg, arrowImg = nil, nil, nil, nil
	local textLabel = nil
	local popupData = {Frame=nil, Open=false, Width=0, Height=0, UserInputConnection=nil, RenderConnection=nil}

	local optionButtons = {}
	local arrowRotation = 0
	local allButton = nil
	local allSelected = false

	-- Selected state for the main button (open/closed)
	local mainSelectedState = { value = false }

	local function updateMainButtonText()
		local selected = {}
		for opt, sel in pairs(selectedMap) do
			if sel then table.insert(selected, opt) end
		end
		local count = #selected
		if count == 0 then
			textLabel.Text = "None"
		else
			textLabel.Text = "(" .. count .. ") Selected"
		end
	end

	local function parseAlignment(align)
		if type(align)=="string" then
			if align=="Left" then return Enum.TextXAlignment.Left
			elseif align=="Center" then return Enum.TextXAlignment.Center
			elseif align=="Right" then return Enum.TextXAlignment.Right
			else return Enum.TextXAlignment.Center end
		elseif typeof(align)=="EnumItem" and align.EnumType==Enum.TextXAlignment then
			return align
		else return Enum.TextXAlignment.Center end
	end

	local function buildDropdown(parent, posY)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0,buttonW,0,buttonH)
		b.Position = UDim2.new(0,0,0,posY or 0)
		b.BackgroundColor3 = bgCol
		b.BackgroundTransparency = bgTrans
		b.Text = ""
		b.AutoButtonColor = false
		b.BorderSizePixel = 0
		b.ZIndex = 7
		b.Parent = parent

		local tl = Instance.new("TextLabel", b)
		tl.BackgroundTransparency = 1
		tl.Text = "None"
		tl.TextColor3 = buttonTextCol
		tl.TextTransparency = buttonTextTrans
		tl.Font = buttonFont
		tl.TextSize = buttonTextSz
		tl.RichText = true
		tl.ZIndex = b.ZIndex + 1
		tl.Size = UDim2.new(1, 0, 1, 0)
		tl.Position = UDim2.new(0, 0, 0, 0)

		tl.TextXAlignment = parseAlignment(buttonTextAlignment)
		tl.TextYAlignment = Enum.TextYAlignment.Center
		local offX = buttonTextOffset[1] or 0
		local offY = buttonTextOffset[2] or 0
		if offX ~= 0 or offY ~= 0 then
			tl.Position = UDim2.new(0, offX, 0, offY)
		end

		if buttonOlThick > 0 then
			local stroke = Instance.new("UIStroke", tl)
			stroke.Thickness = buttonOlThick
			stroke.Color = buttonOlCol
			stroke.Transparency = buttonOlTrans
		end

		if corners>0 then Instance.new("UICorner", b).CornerRadius = UDim.new(0,corners) end
		if olThick>0 then
			local s = Instance.new("UIStroke", b)
			s.Thickness = olThick
			s.Color = olCol
			s.Transparency = olTrans
			s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		end
		addTextureToFrame(b, tex, texSz, texTrans, texCol, corners)

		if iconAsset then
			iconImg = Instance.new("ImageLabel", b)
			iconImg.BackgroundTransparency = 1
			iconImg.Size = UDim2.fromOffset(iconW, iconH)
			iconImg.Image = formatAsset(iconAsset)
			iconImg.ImageColor3 = iconCol
			iconImg.ImageTransparency = iconTrans
			iconImg.ZIndex = 8
			if iconAlign=="Left" then
				iconImg.AnchorPoint=Vector2.new(0,0.5)
				iconImg.Position=UDim2.new(0, iconOff[1] or 0, 0.5, iconOff[2] or 0)
			elseif iconAlign=="Right" then
				iconImg.AnchorPoint=Vector2.new(1,0.5)
				iconImg.Position=UDim2.new(1, -(iconOff[1] or 0), 0.5, iconOff[2] or 0)
			else
				iconImg.AnchorPoint=Vector2.new(0.5,0.5)
				iconImg.Position=UDim2.new(0.5, iconOff[1] or 0, 0.5, iconOff[2] or 0)
			end
			if iconCirc>0 then Instance.new("UICorner", iconImg).CornerRadius = UDim.new(0,iconCirc) end
		end

		if icon2Asset then
			arrowImg = Instance.new("ImageLabel", b)
			arrowImg.BackgroundTransparency = 1
			arrowImg.Size = UDim2.fromOffset(icon2W, icon2H)
			arrowImg.Image = formatAsset(icon2Asset)
			arrowImg.ImageColor3 = icon2Col
			arrowImg.ImageTransparency = icon2Trans
			arrowImg.ZIndex = 9
			local align = icon2Align
			local offX2 = icon2Off[1] or 0
			local offY2 = icon2Off[2] or 0
			if align=="Left" then
				arrowImg.AnchorPoint=Vector2.new(0,0.5)
				arrowImg.Position=UDim2.new(0, offX2, 0.5, offY2)
			elseif align=="Right" then
				arrowImg.AnchorPoint=Vector2.new(1,0.5)
				arrowImg.Position=UDim2.new(1, -offX2, 0.5, offY2)
			else
				arrowImg.AnchorPoint=Vector2.new(0.5,0.5)
				arrowImg.Position=UDim2.new(0.5, offX2, 0.5, offY2)
			end
			arrowImg.Rotation = 0
			if icon2Circ>0 then Instance.new("UICorner", arrowImg).CornerRadius = UDim.new(0,icon2Circ) end
		end

		if fx then
			Library.ApplyEffects(b, fx, fx, mainSelectedState, fx, "DropdownHighlight", "SelectedDropdown")
		end

		return b, tl
	end

	if not showLabel then
		btn, textLabel = buildDropdown(container, 0)
	elseif textSide=="Up" then
		labelObj = Instance.new("TextLabel", container)
		labelObj.BackgroundTransparency = 1
		labelObj.Text = labelText
		labelObj.Font = labelFont
		labelObj.TextSize = labelSz
		labelObj.TextColor3 = labelCol
		labelObj.TextTransparency = labelTrans
		labelObj.RichText = true
		labelObj.ZIndex = 6
		labelObj.TextXAlignment = Enum.TextXAlignment.Center
		labelObj.Size = UDim2.new(1,0,0,labelHeight)
		labelObj.Position = UDim2.new(0, labelOff[1] or 0, 0, labelOff[2] or 0)
		if labelOlThick>0 then
			local s = Instance.new("UIStroke", labelObj)
			s.Thickness = labelOlThick
			s.Color = labelOlCol
			s.Transparency = labelOlTrans
		end
		btn, textLabel = buildDropdown(container, labelHeight+textGap)
	elseif textSide=="Down" then
		labelObj = Instance.new("TextLabel", container)
		labelObj.BackgroundTransparency = 1
		labelObj.Text = labelText
		labelObj.Font = labelFont
		labelObj.TextSize = labelSz
		labelObj.TextColor3 = labelCol
		labelObj.TextTransparency = labelTrans
		labelObj.RichText = true
		labelObj.ZIndex = 6
		labelObj.TextXAlignment = Enum.TextXAlignment.Center
		labelObj.Size = UDim2.new(1,0,0,labelHeight)
		labelObj.Position = UDim2.new(0, labelOff[1] or 0, 0, buttonH+textGap+(labelOff[2] or 0))
		if labelOlThick>0 then
			local s = Instance.new("UIStroke", labelObj)
			s.Thickness = labelOlThick
			s.Color = labelOlCol
			s.Transparency = labelOlTrans
		end
		btn, textLabel = buildDropdown(container, 0)
	end

	updateMainButtonText()

	local function rotateArrow(targetRotation, duration)
		if arrowImg then
			local info = TweenInfo.new(duration or 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			local tween = TweenService:Create(arrowImg, info, {Rotation = targetRotation})
			tween:Play()
			arrowRotation = targetRotation
		end
	end

	local function getScreenGui()
		if not btn then return PlayerGui end
		return btn:FindFirstAncestorOfClass("ScreenGui") or PlayerGui
	end

	local function positionPopup()
		if not popupData.Frame or not btn or not btn.Parent then return end
		local btnAbsPos, btnAbsSize
		local ok, err = pcall(function()
			btnAbsPos = btn.AbsolutePosition
			btnAbsSize = btn.AbsoluteSize
		end)
		if not ok then return end
		local popupW = popupData.Width or 120
		local popupH = popupData.Height or 60
		local screenGui = getScreenGui()
		if not screenGui then return end
		local screenSize = screenGui.AbsoluteSize
		if screenSize.X==0 or screenSize.Y==0 then return end
		local x, y
		if boardSide=="Left" then
			x = btnAbsPos.X - popupW - 6
			x = math.max(0, math.min(x, screenSize.X - popupW))
		else
			x = btnAbsPos.X + btnAbsSize.X + 6
			x = math.max(0, math.min(x, screenSize.X - popupW))
		end
		y = btnAbsPos.Y
		y = math.max(0, math.min(y, screenSize.Y - popupH))
		popupData.Frame.Position = UDim2.new(0,x,0,y)
	end

	local function closePopup()
		if not popupData.Open then return end
		popupData.Open = false

		mainSelectedState.value = false
		local hl = HighlightRegistry[btn]
		if hl and hl.Stop then hl.Stop() end

		local targetRotation = arrowRotation + 180
		rotateArrow(targetRotation, 0.25)

		if popupData.Frame then
			popupData.Frame:Destroy()
			popupData.Frame = nil
		end
		if popupData.UserInputConnection then
			popupData.UserInputConnection:Disconnect()
			popupData.UserInputConnection = nil
		end
		if popupData.RenderConnection then
			popupData.RenderConnection:Disconnect()
			popupData.RenderConnection = nil
		end
		for i=#openDropdownClosers,1,-1 do
			if openDropdownClosers[i]==closePopup then
				table.remove(openDropdownClosers,i)
			end
		end
	end

	local function createPopup()
		if popupData.Frame then return end
		local screenGui = getScreenGui()
		local popupFrame = Instance.new("Frame")
		popupFrame.Name = "MultiDropdownPopup"
		popupFrame.BackgroundColor3 = boardBgCol
		popupFrame.BackgroundTransparency = boardBgTrans
		popupFrame.BorderSizePixel = 0
		popupFrame.ZIndex = 100
		popupFrame.Active = false
		popupFrame.Draggable = false
		popupFrame.Parent = screenGui
		if boardCorners>0 then
			Instance.new("UICorner", popupFrame).CornerRadius = UDim.new(0,boardCorners)
		end
		if boardOlThick>0 then
			local s = Instance.new("UIStroke", popupFrame)
			s.Thickness = boardOlThick
			s.Color = boardOlCol
			s.Transparency = boardOlTrans
			s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		end
		addTextureToFrame(popupFrame, boardTex, boardTexSz, boardTexTrans, boardTexCol, boardCorners)

		local headerHeight = 30
		local headerFrame = Instance.new("Frame", popupFrame)
		headerFrame.Size = UDim2.new(1,-16,0,headerHeight)
		headerFrame.Position = UDim2.new(0,8,0,4)
		headerFrame.BackgroundTransparency = 1
		headerFrame.ZIndex = 101

		local boardIconImg = nil
		local hasIcon = boardIconAsset and true or false
		if hasIcon then
			boardIconImg = Instance.new("ImageLabel", headerFrame)
			boardIconImg.BackgroundTransparency = 1
			boardIconImg.Size = UDim2.fromOffset(boardIconW, boardIconH)
			boardIconImg.Image = formatAsset(boardIconAsset)
			boardIconImg.ImageColor3 = boardIconCol
			boardIconImg.ImageTransparency = boardIconTrans
			boardIconImg.ZIndex = 102
			local align = boardIconAlign
			local offX = boardIconOff[1] or 0
			local offY = boardIconOff[2] or 0
			if align=="Left" then
				boardIconImg.AnchorPoint=Vector2.new(0,0.5)
				boardIconImg.Position=UDim2.new(0,offX,0.5,offY)
			elseif align=="Right" then
				boardIconImg.AnchorPoint=Vector2.new(1,0.5)
				boardIconImg.Position=UDim2.new(1,-offX,0.5,offY)
			else
				boardIconImg.AnchorPoint=Vector2.new(0.5,0.5)
				boardIconImg.Position=UDim2.new(0.5,offX,0.5,offY)
			end
			if boardIconCirc>0 then
				Instance.new("UICorner", boardIconImg).CornerRadius = UDim.new(0,boardIconCirc)
			end
		end

		local titleLabel = Instance.new("TextLabel", headerFrame)
		titleLabel.BackgroundTransparency = 1
		titleLabel.Text = popupTitle
		titleLabel.Font = boardTitleFont
		titleLabel.TextSize = boardTitleSz
		titleLabel.TextColor3 = boardTitleCol
		titleLabel.TextTransparency = boardTitleTrans
		titleLabel.RichText = true
		titleLabel.ZIndex = 103
		local textAlign = boardTitleAlign
		local textAlignEnum = (textAlign=="Left" and Enum.TextXAlignment.Left) or (textAlign=="Right" and Enum.TextXAlignment.Right) or Enum.TextXAlignment.Center
		titleLabel.TextXAlignment = textAlignEnum
		titleLabel.TextYAlignment = Enum.TextYAlignment.Center
		local overlap = hasIcon and boardIconAlign==textAlign
		local offX = boardTitleOff[1] or 0
		local offY = boardTitleOff[2] or 0
		if overlap then
			titleLabel.Size = UDim2.new(1,0,1,0)
			if textAlign=="Left" then
				titleLabel.AnchorPoint=Vector2.new(0,0.5)
				titleLabel.Position=UDim2.new(0,offX,0.5,offY)
			elseif textAlign=="Right" then
				titleLabel.AnchorPoint=Vector2.new(1,0.5)
				titleLabel.Position=UDim2.new(1,-offX,0.5,offY)
			else
				titleLabel.AnchorPoint=Vector2.new(0.5,0.5)
				titleLabel.Position=UDim2.new(0.5,offX,0.5,offY)
			end
		else
			titleLabel.Size = UDim2.new(1,0,1,0)
			if textAlign=="Left" then
				titleLabel.AnchorPoint=Vector2.new(0,0.5)
				titleLabel.Position=UDim2.new(0,offX,0.5,offY)
			elseif textAlign=="Right" then
				titleLabel.AnchorPoint=Vector2.new(1,0.5)
				titleLabel.Position=UDim2.new(1,-offX,0.5,offY)
			else
				titleLabel.AnchorPoint=Vector2.new(0.5,0.5)
				titleLabel.Position=UDim2.new(0.5,offX,0.5,offY)
			end
		end
		if boardTitleOlThick>0 then
			local s = Instance.new("UIStroke", titleLabel)
			s.Thickness = boardTitleOlThick
			s.Color = boardTitleOlCol
			s.Transparency = boardTitleOlTrans
		end

		local maxPerColumn = 5
		local cellW = 54
		local cellH = 22
		local cellPadding = 4
		local gridPadding = 5
		local columns = math.ceil((#options + 1) / maxPerColumn)
		local rows = math.min(#options + 1, maxPerColumn)
		local contentW = columns*(cellW+cellPadding)-cellPadding + gridPadding*2
		local contentH = rows*(cellH+cellPadding)-cellPadding + gridPadding*2

		local optionsScroll = Instance.new("ScrollingFrame", popupFrame)
		optionsScroll.Size = UDim2.new(0,contentW,0,contentH)
		optionsScroll.Position = UDim2.new(0,8,0,headerHeight+8)
		optionsScroll.BackgroundTransparency = 1
		optionsScroll.BorderSizePixel = 0
		optionsScroll.ZIndex = 104
		optionsScroll.ScrollBarThickness = 3
		optionsScroll.ScrollBarImageColor3 = boardTitleCol or Color3.fromRGB(255,255,255)
		optionsScroll.CanvasSize = UDim2.new(0,contentW,0,contentH)
		optionsScroll.ClipsDescendants = true

		local gridLayout = Instance.new("UIGridLayout", optionsScroll)
		gridLayout.FillDirection = Enum.FillDirection.Vertical
		gridLayout.FillDirectionMaxCells = maxPerColumn
		gridLayout.CellSize = UDim2.new(0,cellW,0,cellH)
		gridLayout.CellPadding = UDim2.new(0,cellPadding,0,cellPadding)
		gridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		gridLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		gridLayout.SortOrder = Enum.SortOrder.LayoutOrder

		local gridPad = Instance.new("UIPadding", optionsScroll)
		gridPad.PaddingTop = UDim.new(0,gridPadding)
		gridPad.PaddingBottom = UDim.new(0,gridPadding)
		gridPad.PaddingLeft = UDim.new(0,gridPadding)
		gridPad.PaddingRight = UDim.new(0,gridPadding)

		optionButtons = {}
		allButton = nil
		allSelected = false

		local function createOptionButton(opt, isAll)
			local optBtn = Instance.new("TextButton", optionsScroll)
			optBtn.Size = UDim2.new(1,0,1,0)
			optBtn.BackgroundColor3 = btnBgCol
			optBtn.BackgroundTransparency = btnBgTrans
			optBtn.Text = opt
			optBtn.TextColor3 = btnTextCol
			optBtn.TextTransparency = btnTextTrans
			optBtn.Font = btnTextFont
			optBtn.TextSize = btnTextSz
			optBtn.AutoButtonColor = false
			optBtn.BorderSizePixel = 0
			optBtn.ZIndex = 105

			optBtn.TextXAlignment = parseAlignment(btnTextAlignment)
			optBtn.TextYAlignment = Enum.TextYAlignment.Center

			if btnTextOffset and #btnTextOffset >= 2 then
				local offX = btnTextOffset[1] or 0
				local offY = btnTextOffset[2] or 0
				if offX ~= 0 or offY ~= 0 then
					local pad = Instance.new("UIPadding", optBtn)
					if offX ~= 0 then
						pad.PaddingLeft = UDim.new(0, offX)
						pad.PaddingRight = UDim.new(0, -offX)
					end
					if offY ~= 0 then
						pad.PaddingTop = UDim.new(0, offY)
						pad.PaddingBottom = UDim.new(0, -offY)
					end
				end
			end

			if btnCorners>0 then
				Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0,math.min(4,btnCorners))
			end
			if btnOlThick>0 then
				local s = Instance.new("UIStroke", optBtn)
				s.Thickness = btnOlThick
				s.Color = btnOlCol
				s.Transparency = btnOlTrans
				s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			end
			if btnTex then
				addTextureToFrame(optBtn, btnTex, btnTexSz, btnTexTrans, btnTexCol, btnCorners)
			end

			return optBtn
		end

		local allBtn = createOptionButton("All", true)
		allButton = allBtn
		optionButtons["__ALL__"] = allBtn

		local allSelectedState = { value = false }

		local optionStates = {}
		local optionButtonsList = {}

		for i, opt in ipairs(options) do
			local optBtn = createOptionButton(opt, false)
			optionButtons[opt] = optBtn
			optionButtonsList[opt] = optBtn
			local isSelected = selectedMap[opt] or false
			local optSelectedState = { value = isSelected }
			optionStates[opt] = optSelectedState
		end

		if fx then
			Library.ApplyEffects(allBtn, fx, fx, allSelectedState, fx, "OptionHighlight", "SelectedOption")
		end

		for opt, optBtn in pairs(optionButtonsList) do
			local state = optionStates[opt]
			if fx then
				Library.ApplyEffects(optBtn, fx, fx, state, fx, "OptionHighlight", "SelectedOption")
			end
			if state.value then
				local hl = HighlightRegistry[optBtn]
				if hl and hl.Start then hl.Start() end
			end
		end

		allBtn.MouseButton1Click:Connect(function()
			allSelected = not allSelected
			local newState = allSelected
			allSelectedState.value = newState
			local allHl = HighlightRegistry[allBtn]
			if newState then
				if allHl and allHl.Start then allHl.Start() end
			else
				if allHl and allHl.Stop then allHl.Stop() end
			end
			for opt, btn in pairs(optionButtons) do
				if opt ~= "__ALL__" then
					selectedMap[opt] = newState
					local state = optionStates[opt]
					if state then
						state.value = newState
						local hl = HighlightRegistry[btn]
						if newState then
							if hl and hl.Start then hl.Start() end
						else
							if hl and hl.Stop then hl.Stop() end
						end
					end
				end
			end
			updateMainButtonText()
			local selected = {}
			for k, v in pairs(selectedMap) do
				if v then table.insert(selected, k) end
			end
			callback(selected)
		end)

		for opt, optBtn in pairs(optionButtonsList) do
			optBtn.MouseButton1Click:Connect(function()
				local newState = not selectedMap[opt]
				selectedMap[opt] = newState
				local state = optionStates[opt]
				if state then
					state.value = newState
					local hl = HighlightRegistry[optBtn]
					if newState then
						if hl and hl.Start then hl.Start() end
					else
						if hl and hl.Stop then hl.Stop() end
					end
				end
				updateMainButtonText()
				local selected = {}
				for k, v in pairs(selectedMap) do
					if v then table.insert(selected, k) end
				end
				callback(selected)
			end)
		end

		local popupW = contentW + 16
		local popupH = headerHeight + 8 + contentH + 8
		popupFrame.Size = UDim2.new(0,popupW,0,popupH)
		popupData.Frame = popupFrame
		popupData.Width = popupW
		popupData.Height = popupH

		local function onInputBegan(input, gameProcessed)
			if gameProcessed then return end
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				local pos = input.Position
				if not popupData.Frame or not popupData.Frame.Parent then return end
				local absPos = popupData.Frame.AbsolutePosition
				local absSize = popupData.Frame.AbsoluteSize
				local inside = pos.X>=absPos.X and pos.X<=absPos.X+absSize.X and pos.Y>=absPos.Y and pos.Y<=absPos.Y+absSize.Y
				local onButton = false
				if btn and btn.Parent then
					local btnAbsPos = btn.AbsolutePosition
					local btnAbsSize = btn.AbsoluteSize
					onButton = pos.X>=btnAbsPos.X and pos.X<=btnAbsPos.X+btnAbsSize.X and pos.Y>=btnAbsPos.Y and pos.Y<=btnAbsPos.Y+btnAbsSize.Y
				end
				if not inside and not onButton then closePopup() end
			end
		end

		popupData.UserInputConnection = UserInputService.InputBegan:Connect(onInputBegan)
		local renderConn = RunService.RenderStepped:Connect(function()
			if popupData.Open and popupData.Frame then positionPopup() end
		end)
		popupData.RenderConnection = renderConn
		table.insert(openDropdownClosers, closePopup)
	end

	local function openPopup()
		if popupData.Open then return end

		mainSelectedState.value = true
		local hl = HighlightRegistry[btn]
		if hl and hl.Start then hl.Start() end

		local targetRotation = arrowRotation + 180
		rotateArrow(targetRotation, 0.25)

		if not popupData.Frame then createPopup() end
		popupData.Open = true
		if popupData.Frame then
			popupData.Frame.Visible = true
			positionPopup()
		end
	end

	local function togglePopup()
		if popupData.Open then
			closePopup()
		else
			Library._CloseAllDropdowns()
			openPopup()
		end
	end

	if btn then
		btn.MouseButton1Click:Connect(togglePopup)
	end

	updateOffset(scrollFrame, buttonW)
	if parent.RefreshHeight then parent.RefreshHeight() end
	return btn
end

print("Crossy's Animated UI Library loaded successfully! (All features: Tabs, Buttons, Knobs, Dropdowns, MultiDropdown, TextBox)")
return Library