local function buildHeader(parent, iconAsset, iconSize, iconAlignment, iconOffset, iconCircular, iconColor, iconTransparency,
	titleText, titleSize, titleColor, titleFont, titleTransparency, titleOutlineThickness, titleOutlineColor, titleOutlineTransparency,
	titleOffset, titleAlignment)
	iconAlignment = iconAlignment or "Left"; titleAlignment = titleAlignment or "Left"
	iconColor = iconColor or Color3.fromRGB(255,255,255); iconTransparency = iconTransparency or 0
	titleTransparency = titleTransparency or 0; titleOutlineTransparency = titleOutlineTransparency or 0
	local iconSz = type(iconSize)=="number" and {iconSize,iconSize} or iconSize or {40,40}
	local iconW, iconH = iconSz[1] or 40, iconSz[2] or 40
	local iconImg, titleLabel = nil, nil
	if iconAsset then
		iconImg = Instance.new("ImageLabel", parent); iconImg.BackgroundTransparency = 1
		iconImg.Size = UDim2.fromOffset(iconW, iconH); iconImg.Image = iconAsset
		iconImg.ImageColor3 = iconColor; iconImg.ImageTransparency = iconTransparency; iconImg.ZIndex = 10
		if iconAlignment == "Left" then iconImg.AnchorPoint = Vector2.new(0,0.5); iconImg.Position = UDim2.new(0, iconOffset[1] or 0, 0.5, iconOffset[2] or 0)
		elseif iconAlignment == "Right" then iconImg.AnchorPoint = Vector2.new(1,0.5); iconImg.Position = UDim2.new(1, -(iconOffset[1] or 0), 0.5, iconOffset[2] or 0)
		else iconImg.AnchorPoint = Vector2.new(0.5,0.5); iconImg.Position = UDim2.new(0.5, iconOffset[1] or 0, 0.5, iconOffset[2] or 0) end
		if iconCircular>0 then Instance.new("UICorner", iconImg).CornerRadius = UDim.new(0,iconCircular) end
	end
	if titleText and titleText ~= "" then
		titleLabel = Instance.new("TextLabel", parent); titleLabel.BackgroundTransparency = 1; titleLabel.Text = titleText
		titleLabel.Font = titleFont; titleLabel.TextSize = titleSize; titleLabel.TextColor3 = titleColor
		titleLabel.TextTransparency = titleTransparency; titleLabel.RichText = true; titleLabel.ZIndex = 3
		local align = (type(titleAlignment)=="string" and ({Left=Enum.TextXAlignment.Left, Center=Enum.TextXAlignment.Center, Right=Enum.TextXAlignment.Right})[titleAlignment]) or (typeof(titleAlignment)=="EnumItem" and titleAlignment) or Enum.TextXAlignment.Center
		titleLabel.TextXAlignment = align
		local offsetX, offsetY = titleOffset[1] or 0, titleOffset[2] or 0
		local overlap = iconImg and iconAlignment == titleAlignment
		if titleAlignment == "Center" then
			titleLabel.Size = UDim2.new(1,0,1,0); titleLabel.AnchorPoint = Vector2.new(0.5,0.5); titleLabel.Position = UDim2.new(0.5, offsetX, 0.5, offsetY)
		elseif overlap then
			titleLabel.Size = UDim2.new(1,0,1,0)
			if titleAlignment == "Left" then titleLabel.AnchorPoint = Vector2.new(0,0.5); titleLabel.Position = UDim2.new(0, offsetX, 0.5, offsetY)
			elseif titleAlignment == "Right" then titleLabel.AnchorPoint = Vector2.new(1,0.5); titleLabel.Position = UDim2.new(1, -offsetX, 0.5, offsetY) end
		else
			titleLabel.Size = UDim2.new(1,0,1,0)
			if titleAlignment == "Left" then titleLabel.AnchorPoint = Vector2.new(0,0.5); titleLabel.Position = UDim2.new(0, offsetX, 0.5, offsetY)
			elseif titleAlignment == "Right" then titleLabel.AnchorPoint = Vector2.new(1,0.5); titleLabel.Position = UDim2.new(1, -offsetX, 0.5, offsetY) end
		end
		if titleOutlineThickness>0 then
			local stroke = Instance.new("UIStroke", titleLabel); stroke.Thickness = titleOutlineThickness; stroke.Color = titleOutlineColor; stroke.Transparency = titleOutlineTransparency
		end
	end
	return iconImg, titleLabel
end

