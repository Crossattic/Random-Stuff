local function packCFrame(cf: CFrame)
	local x,y,z,r00,r01,r02,r10,r11,r12,r20,r21,r22 = cf:GetComponents()
	return {x,y,z,r00,r01,r02,r10,r11,r12,r20,r21,r22}
end
local function unpackCFrame(list)
	if typeof(list)~="table" or #list<12 then return nil end
	return CFrame.new(list[1],list[2],list[3],list[4],list[5],list[6],list[7],list[8],list[9],list[10],list[11],list[12])
end
local function wheelsOn(car: Model?): {BasePart}
	local wheels = {}
	if not car then return wheels end
	for _,inst in ipairs(car:GetDescendants()) do
		if inst:IsA("BasePart") and string.lower(inst.Name)=="wheel" and inst.Parent and string.lower(inst.Parent.Name)=="wheel" then
			table.insert(wheels, inst)
		end
	end
	table.sort(wheels, function(a,b)
		if math.abs(a.Position.Z-b.Position.Z)>0.05 then return a.Position.Z<b.Position.Z end
		return a.Position.X<b.Position.X
	end)
	return wheels
end
local function carFromUserId(userId: number): Model?
	local plr = Players:GetPlayerByUserId(userId)
	if not plr then return getCar() end
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	if seat then
		local model = seat:FindFirstAncestorOfClass("Model")
		if model then return model end
	end
	return getCar()
end
local function sendWheelVisuals()
	if not visualRemote or not drivingNow then return end
	local now = os.clock()
	if now-lastVisualSend<0.05 then return end
	lastVisualSend = now
	local packed = {}
	if Drive._orbiting and Drive._orbitUnits then
		for _,unit in ipairs(Drive._orbitUnits) do
			if unit.part and unit.part.Parent then
				table.insert(packed, packCFrame(unit.part.CFrame))
			end
		end
	elseif Drive.IsHoverWheels and Drive.IsHoverWheels() then
		for _,wheelPart in ipairs(getWheels()) do
			table.insert(packed, packCFrame(wheelPart.CFrame))
		end
	end
	visualRemote:FireServer({
		hover = Drive.IsHoverWheels and Drive.IsHoverWheels() or false,
		orbit = Drive._orbiting and true or false,
		cfs = packed,
	})
end
if visualRemote then
	visualRemote.OnClientEvent:Connect(function(userId, data)
		if userId==LocalPlayer.UserId then return end
		if typeof(data)~="table" then return end
		local car = carFromUserId(userId)
		if not car then return end
		local wheels = wheelsOn(car)
		if data.clear or (not data.hover and not data.orbit) then
			return
		end
		if typeof(data.cfs)=="table" then
			for i,list in ipairs(data.cfs) do
				local wheelPart = wheels[i]
				local cf = unpackCFrame(list)
				if wheelPart and cf then
					wheelPart.CFrame = cf
				end
			end
		end
	end)
	RunService.Heartbeat:Connect(function()
		sendWheelVisuals()
	end)
end

