	ButtonId = "Drive",
	StartHidden = true,
	Execution = function()
		if drivingNow then
			return
		end
		drivingNow = true
		driveReady = false
		ShopModule.SetDriving(true)
		HideAbilityButton("Drive")
		HideAbilityButton("Dash")
		if not hoverWheelsUnlocked then
			DriveModule.RotatingTires(true)
			captureDefaultWheelData()
		end
		ScoreModule.ResetScore()
		FuelBarModule.SlideIn()
		FuelBarModule.SetFuel(1)
		ScoreModule.FlyUp(1)
		ScoreModule.PassiveRotating(15, 0.75)
		task.wait(0.25)
		if hoverWheelsUnlocked then
			ensureHoverBaseplate()
			local hoverBaseplate = Workspace:FindFirstChild("HoverWheelsAntiVoidBaseplate")
			if hoverBaseplate and hoverBaseplate:IsA("BasePart") then
				hoverBaseplate.CanCollide = true
			end
		end
		CarAttachModule.StartUpCar()
		if hoverWheelsUnlocked then
			DriveModule.SetHoverWheels(true)
		end
		DriveModule.CarSmoke(true)
		task.wait(startupWait)
		if orbitingWheelUnlocked and not hoverWheelsUnlocked then
			DriveModule._orbitWheelCount = if baybladeUnlocked then 2 else 1
			DriveModule.SetOrbitingWheel(true)
		end
		driveReady = true
		if dashUnlocked then
			ShowAbilityButton("Dash")
		end
		if spinnerOfDeathUnlocked then
			ShowAbilityButton("Spinner")
		end

		HitboxModule.AddHitbox({
			Offset = Vector3.new(0, 0, -3),
			Size = Vector3.new(8, 8, 8),
			HitCooldown = 1,
			TouchExecution = function(part)
				ScoreModule.TextFlash()
				ScoreModule.SpinScore(0.5)
				HitboxModule.PlayS("rbxassetid://124543461907751", 1, 0)
				FuelBarModule.AddFuel(fuelRefillDuration / fuelDuration, 0.5)
				local scoreAward = math.floor(250 * scoreMultiplier + 0.5)
				ScoreModule.AddScore(scoreAward)
				ScoreModule.ScoreNotif("Ran-over", scoreAward)
				HitboxModule.HitEffect(part, 255, 0, 0, 0.5)
				task.spawn(function()
					local events = ReplicatedStorage:FindFirstChild("Events")
					local butcher = events and events:FindFirstChild("butcherAttack")
					if butcher then
						for i = 1, 3 do
							pcall(function()
								butcher:InvokeServer("hitConfirm")
							end)
							if i < 3 then
								task.wait(0.1)
							end
						end
					end
				end)
			end,
		})

		FuelBarModule.BarShaking(true)
		FuelBarModule.StartDraining(1 / fuelDuration)
		DriveModule._hoverStartupActive = false
		DriveModule.CarDrive(true)
		if hoverWheelsUnlocked then
			local currentCar = getCar()
			local primaryPart = currentCar and (currentCar.PrimaryPart or currentCar:FindFirstChildWhichIsA("BasePart"))
			if primaryPart then
				local secondDriveSound = Instance.new("Sound")
				secondDriveSound.Name = "DriveEngineSoundSecondary"
				secondDriveSound.SoundId = "rbxassetid://116593009114624"
				secondDriveSound.Volume = 2
				secondDriveSound.Looped = true
				secondDriveSound.PlaybackSpeed = 1.65
				secondDriveSound.Parent = primaryPart
				secondDriveSound:Play()
				DriveModule._secondDriveSound = secondDriveSound
			end
		end
		DriveModule.SpeedLines(true)
	end
})

AddAbilityButton({
	Key = "Q",
Description = "Dash",
	ButtonId = "Dash",
	StartHidden = true,
	Execution = function()
		if not drivingNow or not driveReady or not dashUnlocked then
			return
		end
		local fuelCost = 2.5 / math.max(fuelDuration, 0.001)
		if FuelBarModule.GetFuel() < fuelCost then
			return
		end
		if not DriveModule.Dash or not DriveModule.Dash(75) then
			return
		end
		FuelBarModule.ConsumeFuel(fuelCost)
		ActivateCooldown(7, "Dash")

		local characterNow = LocalPlayer.Character
		local root = characterNow and characterNow:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end

		local tempPart = Instance.new("Part")
		tempPart.Name = "DashParticlePart"
		tempPart.Size = Vector3.new(2, 2, 2)
		tempPart.CFrame = root.CFrame * CFrame.new(0, 0, -5)
		tempPart.Anchored = true
		tempPart.CanCollide = true
		tempPart.Transparency = 1
		tempPart.Parent = Workspace

		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxassetid://76255110114797"
		emitter.Rate = 20
		emitter.Speed = NumberRange.new(5, 5)
		emitter.Lifetime = NumberRange.new(0.25, 0.25)
		emitter.RotSpeed = NumberRange.new(0, 0)
		emitter.Rotation = NumberRange.new(-100, 100)
		emitter.Acceleration = Vector3.zero
		emitter.Drag = 0
		emitter.LightEmission = 1
		emitter.LightInfluence = 0
		emitter.ZOffset = 0
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
		emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 40)})
		emitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.75, 0), NumberSequenceKeypoint.new(1, 1.0022189617156982)})
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Orientation = Enum.ParticleOrientation.FacingCamera
		emitter.FlipbookLayout = Enum.ParticleFlipbookLayout.None
		emitter.FlipbookFramerate = NumberRange.new(1, 1)
		emitter.FlipbookMode = Enum.ParticleFlipbookMode.Loop
		emitter.FlipbookStartRandom = false
		emitter.Brightness = 3
		emitter.Squash = NumberSequence.new(0)
		emitter.Shape = Enum.ParticleEmitterShape.Box
		emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
		emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
		emitter.SpreadAngle = Vector2.zero
		emitter.WindAffectsDrag = false
		emitter.TimeScale = 1
		emitter.VelocityInheritance = 0
		emitter.LockedToPart = false
		emitter:SetAttribute("EmitCount", "1")
		emitter.Enabled = true
		emitter.Parent = tempPart

		local dashSounds = {"rbxassetid://6883650972", "rbxassetid://140334012603496"}
		for _, soundId in ipairs(dashSounds) do
			local sound = Instance.new("Sound")
			sound.SoundId = soundId
			sound.Volume = 1
			sound.Parent = root
			sound:Play()
			sound.Ended:Connect(function()
				if sound.Parent then sound:Destroy() end
			end)
		end

		task.spawn(function()
			local started = tick()
			local particleDisabled = false
			while tick() - started < 0.75 and tempPart.Parent and drivingNow do
				local elapsed = tick() - started
				if not particleDisabled and elapsed >= 0.2 then
					particleDisabled = true
					if emitter and emitter.Parent then emitter.Enabled = false end
				end
				local currentCharacter = LocalPlayer.Character
				local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
				if currentRoot then
					tempPart.CFrame = currentRoot.CFrame * CFrame.new(0, 0, -5)
				end
				task.wait(0.05)
			end
			if emitter and emitter.Parent and not particleDisabled then emitter.Enabled = false end
			local elapsed = tick() - started
			local remaining = 1.5 - elapsed
			if remaining > 0 then task.wait(remaining) end
			if tempPart and tempPart.Parent then tempPart:Destroy() end
		end)
	end
})

AddAbilityButton({
	Key = "X",
	Description = "Stop",
	ButtonId = "Stop",
	StartHidden = true,
	Execution = function()
		if not drivingNow or not driveReady then
			return
		end
		FuelBarModule.ForceEmpty()
	end
})

AddAbilityButton({
	Key = "E",
	Description = "Spinner Of Death",
	ButtonId = "Spinner",
	StartHidden = true,
	Execution = function()
		if not drivingNow or not driveReady or not spinnerOfDeathUnlocked then
			return
		end
		if DriveModule._spinnerActive then
			return
		end
		DriveModule._spinnerActive = true
		HitboxModule.PlayS("rbxassetid://111527667207953", 1, 0)
		local oldSpeed = DriveModule.GetSpeed()
		DriveModule.SetSpeed(oldSpeed * 1.2)
		DriveModule._orbitSpinSpeed = 270 * 3.5
		task.delay(7.5, function()
			DriveModule._orbitSpinSpeed = 270
			DriveModule.SetSpeed(oldSpeed)
			DriveModule._spinnerActive = false
		end)
		ActivateCooldown(15, "Spinner")
	end
})

FuelBarModule.FuelEmpty({
	Execution = function()
		HitboxModule.DestroyHitboxes()
		DriveModule.CarDrive(false)
		local secondDriveSound = DriveModule._secondDriveSound
		if secondDriveSound then
			secondDriveSound:Stop()
			secondDriveSound:Destroy()
			DriveModule._secondDriveSound = nil
		end
		DriveModule.SetHoverWheels(false)
		zeroCharacterVerticalVelocity()
		DriveModule._spinnerActive = false
		DriveModule._orbitSpinSpeed = 270
		DriveModule.SetOrbitingWheel(false)
		removeHoverBaseplate()
		DriveModule.SpeedLines(false)
		DriveModule.CarSmoke(false)
		DriveModule.RotatingTires(false)
		local runScore = ScoreModule.GetScore()
		local gained = ShopModule.AwardFromScore(runScore)
		if gained > 0 then
			ScoreModule.ScoreNotif("Points", gained)
		end
		ScoreModule.FlyDown(0.5)
		FuelBarModule.BarFlash(Color3.fromRGB(255, 0, 0), 0.3)
		task.wait(0.5)
		FuelBarModule.BarShaking(false)
		task.wait(0.5)
		FuelBarModule.SlideOut()
		CarAttachModule.CharacterCarUnlock()
		zeroCharacterVerticalVelocity()
		drivingNow = false
		driveReady = false
		HideAbilityButton("Dash")
		ShopModule.SetDriving(false)
		ActivateCooldown(driveCooldown, "Drive")
	end,
})

task.spawn(function()
	while true do
		local seated = isSittingInCar()
		if seated and not drivingNow then
			ShowAbilityButton("Drive")
		else
			HideAbilityButton("Drive")
		end
		if drivingNow and driveReady and dashUnlocked then
			ShowAbilityButton("Dash")
		else
			HideAbilityButton("Dash")
		end
		if drivingNow and driveReady and spinnerOfDeathUnlocked then
			ShowAbilityButton("Spinner")
		else
			HideAbilityButton("Spinner")
		end
		if drivingNow and driveReady then
			ShowAbilityButton("Stop")
		else
			HideAbilityButton("Stop")
		end
		task.wait(0.1)
	end
end)
end

end




