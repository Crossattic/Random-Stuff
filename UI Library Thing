-- === Element constructors ===
local function createElement(name, ...)
	local args = {...}; local steps = {}
	for _, v in ipairs(args) do
		if type(v)=="table" then
			if not v.Color and not v.Trans and (v.Darkening or v.OutlineColorChange or v.Sequence) then
				local seq = v.Sequence or (v.Darkening and v.Darkening.Sequence) or (v.OutlineColorChange and v.OutlineColorChange.Sequence)
				if seq then for _, s in ipairs(seq) do table.insert(steps, s) end end
			elseif v.Color then table.insert(steps, v) end
		end
	end
	return {Name=name, Darkening = #steps>0 and {Sequence=steps} or nil}
end

function Library.Background(...) return createElement("Background", ...) end
function Library.BackgroundOutline(...) return createElement("BackgroundOutline", ...) end
function Library.Text(...) return createElement("Text", ...) end
function Library.TextOutline(...) return createElement("TextOutline", ...) end
function Library.Icon(...) return createElement("Icon", ...) end
function Library.KnobBackground(...) return createElement("KnobBackground", ...) end
function Library.KnobBackgroundOutline(...) return createElement("KnobBackgroundOutline", ...) end
function Library.Knob(...) return createElement("KnobBackground", ...) end

function Library.OutlineColorChange(data) return {Sequence=data.Sequence} end
function Library.Darkening(arr) return {Sequence=arr} end
function Library.Change(arr) return {Sequence=arr} end
function Library.Sequence(arr) return arr end

function Library.ColorChange(...)
	local args = {...}
	if #args==4 then return {Color=Color3.fromRGB(args[1],args[2],args[3]), Duration=args[4]}
	elseif #args==2 then return {Color=args[1]=="Original" and "Original" or toColor3(args[1]), Duration=args[2]}
	else return function(dur) return {Color=Color3.fromRGB(args[1],args[2],args[3]), Duration=dur} end
	end
end

function Library.ColorDarken(r,g,b) return function(dur) return {Color={r or 0, g or 0, b or 0}, Duration=dur or 0.05} end end

